{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MdBoss",
  "version": "0.1.0",
  "identifier": "com.dux.md-boss",
  "mainBinaryName": "md-boss",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "MD-BOSS",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "cli": {
      "description": "Opens folders and files in md-boss: a folder is added to the top of the sidebar, a file is opened and its folder listed. Relative paths resolve against the current directory; while the app runs, a second launch hands them to its window.",
      "args": [
        {
          "name": "paths",
          "index": 1,
          "takesValue": true,
          "multiple": true,
          "description": "Folders and files to open"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
