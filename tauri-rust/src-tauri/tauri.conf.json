{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MdBoss",
  "version": "0.1.0",
  "identifier": "com.dux.md-boss",
  "mainBinaryName": "md-boss",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "MD-BOSS",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dux/md-boss/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGRThENDNGNkMyNENDMjcKUldRbnpDUnNQOVRvdnh2aWFIR1ZabndMVkpRZ3NRMUdXN3REUVhYS1JKQzMydmIyOUVVRHgxOUMK"
    },
    "cli": {
      "description": "Opens folders and files in md-boss: a folder is added to the top of the sidebar, a file is opened and its folder listed. Relative paths resolve against the current directory; while the app runs, a second launch hands them to its window.",
      "args": [
        {
          "name": "paths",
          "index": 1,
          "takesValue": true,
          "multiple": true,
          "description": "Folders and files to open"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 dux",
    "publisher": "dux",
    "homepage": "https://github.com/dux/md-boss",
    "shortDescription": "A markdown viewer and editor that looks like paper",
    "longDescription": "Folders and files on the left, the rendered document on the right. Edit raw markdown side by side with the preview, keep notes anchored to lines, search across a project, and move files with their links rewritten.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin/md-boss": "bin/md-boss"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn",
          "mdwn",
          "qmd",
          "rmd"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text",
        "description": "Plain Text",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "Comma-Separated Values",
        "description": "Comma-Separated Values",
        "mimeType": "text/csv",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [],
        "contentTypes": [
          "public.folder"
        ],
        "name": "Folder",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
