#!/bin/sh
# The `md-boss` command. `md-boss .` adds the current directory to the top of the sidebar,
# `md-boss notes.md` opens the file, several paths open in turn; with the app already
# running the arguments go to its window. Installed to ~/bin by `hammer tauri:link`.
#
# The binary is exec'd directly rather than through `open -a`: the app resolves relative
# paths against this shell's cwd, and only a second process reaches the running window
# (tauri-plugin-single-instance). MD_BOSS_APP points at a binary that lives elsewhere -
# a dev build, an AppImage.
case "$(uname -s)" in
  Darwin) default="/Applications/MdBoss.app/Contents/MacOS/md-boss" ;;
  *)      default="/usr/bin/md-boss" ;;
esac
bin="${MD_BOSS_APP:-$default}"

if [ ! -x "$bin" ]; then
  echo "md-boss: $bin is not there - install the app, or set MD_BOSS_APP to its binary" >&2
  exit 1
fi

# Flags are answered on this terminal (--help, --version); paths start the GUI, which
# must not hold the shell - a second launch returns by itself, the first is detached.
case "$1" in
  -*) exec "$bin" "$@" ;;
esac
nohup "$bin" "$@" >/dev/null 2>&1 &
