<script>
  // The folder tree: rows from the tree model, indented by depth, a chevron on folders.
  // Clicking a folder row toggles it, a file row opens the document.
  //
  // The element is focusable and owns the bare keys while it has focus - arrows, Return,
  // Escape, and letters for type-to-jump. Every modified combination belongs to the app
  // shortcuts (src/ui/keys.ts) and later the menu bar, so a modifier here is left alone.
  class {
    init() {
      this.state.rows = []
      this.state.cursor = 0
      this.state.selected = null
      this.state.cut = null
      this.state.message = null
    }

    onMount() {
      this.local.typeAhead = new MdBoss.TypeAhead()
      this.local.unsubscribe = [
        MdBoss.manager.tree.onChange(() => this.pull()),
        MdBoss.manager.onChange(() => this.pull()),
      ]
      this.root.tabIndex = 0
      this.on(this.root, 'keydown', (event) => this.keyDown(event))
      // Clicking anywhere in the tree gives it the keyboard; a click on a row would also
      // focus through the row, but the empty message has nothing to land on.
      this.on(this.root, 'mousedown', () => this.root.focus())
      this.pull()
      this.root.focus()
    }

    afterRender() {
      // Keep the cursor row on screen as the keyboard moves it. nearest: no jump when it
      // is already visible, so the mouse wheel and the keyboard do not fight.
      const cursor = this.find('.row.cursor')
      if (cursor) cursor.scrollIntoView({ block: 'nearest' })
    }

    onDestroy() {
      for (const off of this.local.unsubscribe || []) off()
    }

    pull() {
      const manager = MdBoss.manager
      const tree = manager.tree
      this.state.rows = tree.rows.map((row) => ({
        path: row.node.path,
        name: row.node.name,
        isDir: row.node.isDir,
        depth: row.depth,
        isDenied: row.isDenied,
        isExpanded: tree.isExpanded(row.node),
      }))
      this.state.cursor = tree.cursor
      this.state.selected = manager.document ? manager.document.path : null
      this.state.cut = manager.cutFile
      this.state.message = this.emptyMessage(manager, tree)
    }

    // MARK: Keyboard

    keyDown(event) {
      if (event.metaKey || event.ctrlKey || event.altKey) return
      if (this.handleKey(event)) {
        event.preventDefault()
        event.stopPropagation()
      }
    }

    /** True when the key was the tree's. An unhandled key is left to bubble, so Escape with
     *  nothing pending stays available to whatever else wants it. */
    handleKey(event) {
      const tree = MdBoss.manager.tree
      switch (event.key) {
        case 'ArrowDown':  return tree.moveCursorBy(1)
        case 'ArrowUp':    return tree.moveCursorBy(-1)
        case 'ArrowRight': return tree.expandOrDescend()
        case 'ArrowLeft':  return tree.collapseOrAscend()
        case 'Home':       return tree.moveCursor(0)
        case 'End':        return tree.moveCursor(tree.rows.length - 1)
        case 'PageDown':   return tree.moveCursorBy(this.pageRows())
        case 'PageUp':     return tree.moveCursorBy(-this.pageRows())
        case 'Enter':
        case ' ': {
          const row = tree.cursorRow
          if (!row) return false
          this.open(tree.cursor)
          return true
        }
        case 'Escape':
          return MdBoss.manager.cancelCut()
        default: {
          const prefix = this.local.typeAhead.append(event.key, performance.now())
          return prefix === null ? false : tree.jumpTo(prefix)
        }
      }
    }

    /** Rows per page, from the visible height and the row height - so Page Down moves by
     *  what is on screen rather than by a number. */
    pageRows() {
      const row = this.find('.row')
      const rowHeight = row ? row.getBoundingClientRect().height || 22 : 22
      return Math.max(1, Math.floor(this.root.clientHeight / rowHeight) - 1)
    }

    emptyMessage(manager, tree) {
      if (tree.rows.length) return null
      const active = manager.activeRoot
      if (!active) return 'No folders yet.\nPress ⌘O to add one.'
      if (tree.activeIsMissing) return `No folder or files found in\n${active}`
      if (tree.activeIsDenied) return 'No access to that folder.'
      return 'No documents here.'
    }

    rowAt(index) {
      return MdBoss.manager.tree.rows[Number(index)]
    }

    toggle(index) {
      const row = this.rowAt(index)
      if (row) MdBoss.manager.tree.toggle(row.node)
    }

    open(index) {
      const row = this.rowAt(index)
      if (!row) return
      MdBoss.manager.tree.moveCursor(Number(index))
      if (row.node.isDir) MdBoss.manager.tree.toggle(row.node)
      else MdBoss.manager.open(row.node.path)
    }
  }
</script>

<style>
  display: block;
  overflow: auto;
  padding: 4px;
  box-sizing: border-box;
  outline: none;

  .empty {
    padding: 24px 12px;
    color: var(--muted);
    text-align: center;
    white-space: pre-line;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 4px;
    height: calc(var(--font-default) + 9px);
    padding: 0 8px;
    border-radius: 5px;
    color: var(--text);
    white-space: nowrap;
    cursor: default;
    user-select: none;
  }

  .row:hover {
    background: var(--surface);
  }

  .row.selected,
  .row.cursor {
    background: var(--selection);
  }

  /* Waiting for a Move Here: drawn faded, the way Finder shows a cut file. */
  .row.cut {
    opacity: 0.5;
  }

  .chevron {
    width: 12px;
    flex: none;
    color: var(--muted);
    font-size: 0.7em;
    text-align: center;
  }

  .icon {
    width: 14px;
    flex: none;
    color: var(--muted);
    font-size: 0.85em;
    text-align: center;
  }

  .row.dir .icon {
    color: var(--accent);
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .denied {
    margin-left: 6px;
    color: var(--muted);
  }
</style>

{#if state.message}
  <div class="empty text-default">{state.message}</div>
{:else}
  {#each state.rows as row, index}
    <div
      class={'row text-default' + (row.isDir ? ' dir' : '') + (row.path === state.selected ? ' selected' : '') + (index === state.cursor ? ' cursor' : '') + (row.path === state.cut ? ' cut' : '')}
      style="padding-left: {8 + row.depth * 14}px"
      title={row.path}
      onclick="fez.open({index})"
    >
      <span class="chevron" onclick!="fez.toggle({index})">{row.isDir ? (row.isExpanded ? '▼' : '▶') : ''}</span>
      <span class="icon">{row.isDir ? '▰' : '▤'}</span>
      <span class="name">{row.name}</span>
      {#if row.isDenied}
        <span class="denied text-small">no access</span>
      {/if}
    </div>
  {/each}
{/if}
