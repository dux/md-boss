<script>
  // One in-window context menu for the whole app, positioned at the click and kept on
  // screen. Closes on a pick, a click anywhere else, Escape, or a scroll.
  class {
    init() {
      this.state.open = false
      this.state.x = 0
      this.state.y = 0
      this.state.items = []
    }

    onMount() {
      this.local.unsubscribe = MdBoss.menus.onOpen((request) => this.show(request))
      this.on(document, 'mousedown', (event) => {
        if (this.state.open && !this.root.contains(event.target)) this.state.open = false
      }, { capture: true })
      this.on(document, 'keydown', (event) => {
        if (!this.state.open || event.key !== 'Escape') return
        event.preventDefault()
        event.stopPropagation()
        this.state.open = false
      }, { capture: true })
      this.on(window, 'blur', () => { this.state.open = false })
    }

    onDestroy() {
      if (this.local.unsubscribe) this.local.unsubscribe()
    }

    show(request) {
      this.local.items = request.items
      this.state.items = request.items.map((item, index) => ({ index, ...item }))
      // Kept inside the window: a menu opened near the right or bottom edge flips back.
      this.state.x = Math.min(request.x, window.innerWidth - 220)
      this.state.y = Math.min(request.y, window.innerHeight - 24 * request.items.length - 16)
      this.state.open = true
    }

    pick(index) {
      const item = this.local.items[Number(index)]
      this.state.open = false
      if (item && item.action && !item.disabled) item.action()
    }
  }
</script>

<style>
  display: block;

  /* Stable root + hidden class, not an {#if} around everything - see change-banner. */
  .menu.hidden {
    display: none;
  }

  .menu {
    position: fixed;
    z-index: 30;
    min-width: 180px;
    padding: 4px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--bg);
    box-shadow: 0 4px 16px var(--border-strong);
  }

  .item {
    display: block;
    width: 100%;
    padding: 3px 10px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    font-family: inherit;
    text-align: left;
    white-space: nowrap;
  }

  .item:hover {
    background: var(--selection);
  }

  .item:disabled {
    color: var(--muted);
  }

  .separator {
    height: 1px;
    margin: 4px 6px;
    background: var(--border);
  }
</style>

<div class={'menu' + (state.open ? '' : ' hidden')} style="left: {state.x}px; top: {state.y}px">
  {#if state.open}
    {#each state.items as item}
      {#if item.separator}
        <div class="separator"></div>
      {:else}
        <button class="item text-default pointer" disabled={!!item.disabled} onclick="fez.pick({item.index})">{item.label}</button>
      {/if}
    {/each}
  {/if}
</div>
