<script>
  // Notes in three reaches: the open document, the rest of the active folder, and every
  // other recent folder. All three titles are always shown, so an empty scope reads as
  // "nothing here" rather than leaving you wondering whether the pane is broken. The two
  // wider ones fold, and start folded, so the notes on what you are actually reading stay
  // at the top of the column.
  class {
    init() {
      this.state.sections = []
    }

    onMount() {
      this.local.unsubscribe = [
        MdBoss.manager.notes.onChange(() => this.pull()),
        MdBoss.manager.onChange(() => this.pull()),
        MdBoss.manager.onCursorChange(() => this.pull()),
        MdBoss.manager.settings.onChange(() => this.pull()),
      ]
      this.pull()
    }

    onDestroy() {
      for (const off of this.local.unsubscribe || []) off()
    }

    pull() {
      const manager = MdBoss.manager
      const store = manager.notes
      const file = manager.document ? manager.document.path : null
      const currentKey = file ? store.key(file) : null
      const all = store.notes
      const partitioned = MdBoss.partitionNotes(all, file, manager.activeRoot, manager.folders.recent, manager.home)
      const open = new Set(manager.settings.data.expandedNoteScopes)
      this.local.notes = new Map(all.map((n) => [n.path + ':' + n.line, n]))
      this.state.sections = MdBoss.NOTE_SCOPES.map((scope) => {
        const notes = partitioned[scope]
        const collapsible = MdBoss.scopeIsCollapsible(scope)
        const isOpen = !collapsible || open.has(scope)
        return {
          scope,
          title: MdBoss.SCOPE_TITLE[scope],
          collapsible,
          isOpen,
          count: notes.length,
          empty: this.emptyMessage(scope, file, all.length),
          groups: isOpen ? this.groups(notes, scope, currentKey, manager.currentLine) : [],
        }
      })
    }

    /** The file scope is a flat list; the wider ones group by document, the widest naming
     *  the project too - a bare basename from another folder is ambiguous. */
    groups(notes, scope, currentKey, currentLine) {
      const row = (n) => ({
        id: n.path + ':' + n.line,
        line: n.line,
        label: MdBoss.noteLabel(n),
        body: n.title && n.body ? n.body : '',
        isCurrent: n.path === currentKey && n.line === currentLine,
      })
      if (scope === 'thisFile') return [{ key: '', title: null, project: null, rows: notes.map(row) }]
      const byPath = new Map()
      for (const n of notes) {
        if (!byPath.has(n.path)) byPath.set(n.path, [])
        byPath.get(n.path).push(n)
      }
      return [...byPath.keys()].sort().map((path) => ({
        key: path,
        title: path.slice(path.lastIndexOf('/') + 1),
        path,
        project: scope === 'allProjects' ? this.projectName(path) : null,
        rows: byPath.get(path).sort((a, b) => a.line - b.line).map(row),
      }))
    }

    projectName(storedPath) {
      const root = MdBoss.manager.folders.rootContaining(MdBoss.manager.notes.expand(storedPath))
      return root ? root.slice(root.lastIndexOf('/') + 1) : null
    }

    emptyMessage(scope, file, total) {
      if (scope !== 'thisFile') return 'no notes'
      if (!file) return 'no file open'
      // With nothing anywhere, this is the only line that can say how to make one.
      if (total === 0) return 'no notes - right-click in the raw pane to add one'
      return 'no notes'
    }

    toggle(scope) {
      if (!MdBoss.scopeIsCollapsible(scope)) return
      const settings = MdBoss.manager.settings
      const open = new Set(settings.data.expandedNoteScopes)
      if (!open.delete(scope)) open.add(scope)
      settings.patch({ expandedNoteScopes: MdBoss.NOTE_SCOPES.filter((s) => open.has(s)) })
    }

    go(id) {
      const note = this.local.notes.get(id)
      if (note) MdBoss.manager.goToNote(note)
    }

    menu(event, id) {
      const note = this.local.notes.get(id)
      if (!note) return
      event.preventDefault()
      const manager = MdBoss.manager
      const items = [
        { label: 'Edit…', action: () => manager.editNote(note) },
        { label: 'Rename…', action: () => manager.renameNote(note) },
      ]
      if (note.body) items.push({ label: 'Copy Text', action: () => manager.copyText(note.body) })
      items.push({ label: 'Copy Path', action: () => manager.copyText(note.path + ':' + note.line, 'Path copied') })
      items.push({ separator: true })
      items.push({ label: 'Delete', action: () => manager.notes.remove(note) })
      MdBoss.menus.open(event.clientX, event.clientY, items)
    }
  }
</script>

<style>
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: var(--sidebar-bg);

  .head {
    padding: 10px 12px 6px;
  }

  .list {
    flex: 1;
    min-height: 0;
    overflow: auto;
    padding-bottom: 12px;
  }

  .section + .section {
    margin-top: 10px;
    border-top: 1px solid var(--border);
  }

  .scope {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 10px 12px 4px;
    cursor: default;
    user-select: none;
  }

  .scope .chevron {
    font-size: 0.8em;
    color: var(--muted);
  }

  .scope .count {
    color: var(--muted);
  }

  .empty {
    padding: 0 12px 6px;
    color: var(--muted);
  }

  .group {
    padding: 2px 8px 0;
  }

  .group .doc {
    display: flex;
    gap: 4px;
    padding: 4px 4px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .group .doc .project {
    color: var(--muted);
  }

  .group .doc .name {
    font-weight: 500;
  }

  .note {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin: 6px 0 0;
    padding: 8px 10px;
    border-radius: 6px;
    background: var(--surface);
    cursor: default;
  }

  /* The bar on the left: accent on the note the caret is on, quote-bar otherwise. */
  .note::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 3px;
    border-radius: 2px;
    background: var(--quote-bar);
  }

  .note.current::before {
    background: var(--accent);
  }

  .note .top {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .note .line {
    min-width: 26px;
    text-align: right;
    color: var(--muted);
  }

  .note .label {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* Same size as the title above it - a note's body is its content, not a caption on it.
     Only the colour steps back. */
  .note .body {
    padding-left: 32px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
</style>

<div class="head text-title">Notes</div>
<div class="list">
  {#each state.sections as section}
    <div class="section">
      <div class="scope" onclick="fez.toggle('{section.scope}')">
        {#if section.collapsible}
          <span class="chevron">{section.isOpen ? '▼' : '▶'}</span>
        {/if}
        <span class="text-title">{section.title}</span>
        {#if section.count > 0}
          <span class="count text-small">{section.count}</span>
        {/if}
      </div>
      {#if section.isOpen}
        {#if section.count === 0}
          <div class="empty text-small">{section.empty}</div>
        {:else}
          {#each section.groups as group}
            <div class="group">
              {#if group.title}
                <div class="doc text-small" title={group.path}>
                  {#if group.project}
                    <span class="project">{group.project}</span><span class="project">/</span>
                  {/if}
                  <span class="name">{group.title}</span>
                </div>
              {/if}
              {#each group.rows as row}
                <div class={'note' + (row.isCurrent ? ' current' : '')} onclick="fez.go('{row.id}')" oncontextmenu="fez.menu(event, '{row.id}')">
                  <div class="top">
                    <span class="line text-small text-mono">{row.line}</span>
                    <span class="label text-default">{row.label}</span>
                  </div>
                  {#if row.body}
                    <div class="body text-default">{row.body}</div>
                  {/if}
                </div>
              {/each}
            </div>
          {/each}
        {/if}
      {/if}
    </div>
  {/each}
</div>
