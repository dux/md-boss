# Hammerfile - build / run helpers for md-boss.
# Run with: hammer <command>   (https://github.com/dux/hammer)
#
# Every build goes through these tasks, local and CI alike: the release workflow installs
# the gem and calls `hammer frontend` / `hammer package --release`, so how the app is put
# together is described once rather than twice in two places that drift.
#
# File work is FileUtils rather than `cp -R` and friends: these tasks run on the Windows
# runner too, where there is no shell to hold them.

require 'json'
require 'fileutils'
require 'rbconfig'
require 'shellwords'

APP_NAME    ||= 'MdBoss'
BINARY_NAME ||= 'md-boss'
BUNDLE_DIR  ||= "#{APP_NAME}.app"
INSTALL_DIR ||= '/Applications'
DEV_URL     ||= 'http://localhost:1430'
MIN_BUN     ||= '1.2.0'
ICON_SIZES  ||= [16, 32, 64, 128, 256, 512, 1024].freeze

# Not VERSION: hammer defines one of its own, and `VERSION ||=` resolves to that rather
# than assigning - which is how every build so far stamped hammer's version into the app.
APP_VERSION ||= JSON.parse(File.read('package.json'))['version']

# What the payload and the bundle carry besides the shell binary. The server runs from
# source - bun runs TypeScript - so there is nothing to compile on that side.
# src/models rides along because server/ imports parsers from it (`../src/models/notes` and
# friends); it resolves in the checkout but not in the bundle unless it is staged too.
PAYLOAD_DIRS ||= %w[server dist src/models].freeze

# Shared by the top-level tasks and the `run:` namespace - a namespace is its own Hammer
# subclass, so it would not otherwise see these. `helpers` defines them on the root class.
HELPERS = proc do
  def host_os
    case RbConfig::CONFIG['host_os']
    when /darwin/            then :macos
    when /mswin|mingw|msys/  then :windows
    else                          :linux
    end
  end

  # The name the release assets and the install scripts agree on.
  def host_target
    arch = RbConfig::CONFIG['host_cpu'].match?(/arm|aarch64/) ? 'arm64' : 'x64'
    case host_os
    when :macos   then "darwin-#{arch}"
    when :windows then 'windows-x64'
    else               "linux-#{arch}"
    end
  end

  def shell_binary(cfg)
    exe = host_os == :windows ? "#{BINARY_NAME}.exe" : BINARY_NAME
    File.join 'shell', 'target', cfg, exe
  end

  def archive_name(ext)
    "#{BINARY_NAME}-#{APP_VERSION}-#{host_target}.#{ext}"
  end

  # `which`, without shelling out to a `which` that Windows does not have.
  def tool?(name)
    exts = host_os == :windows ? %w[.exe .bat .cmd] : ['']
    ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).any? do |dir|
      exts.any? { |ext| File.file?(File.join(dir, "#{name}#{ext}")) }
    end
  end

  # Each entry keeps its path under the staging dir - a nested one like src/models has to
  # land as src/models, not as a bare models/, or the server's `../src/models` misses it.
  def stage_payload(dir)
    PAYLOAD_DIRS.each do |d|
      dest = File.join(dir, d)
      FileUtils.mkdir_p File.dirname(dest)
      FileUtils.cp_r d, dest
    end
    File.write File.join(dir, 'version.txt'), "#{APP_VERSION}\n"
  end

  def need_frontend!
    return if Dir.exist?('dist') && !Dir.empty?('dist')
    error 'dist/ is missing - run `hammer frontend` first'
  end

  # iconutil is macOS-only and needs the PNG set `hammer icon` writes. Returns false
  # rather than raising, so a build on a machine without them still produces an app.
  def build_icns(dest)
    return false unless host_os == :macos && tool?('iconutil')
    return false unless ICON_SIZES.all? { |s| File.exist?("icons/icon_#{s}.png") }

    iconset = 'icons/AppIcon.iconset'
    FileUtils.rm_rf iconset
    FileUtils.mkdir_p iconset
    [16, 32, 128, 256, 512].each do |size|
      FileUtils.cp "icons/icon_#{size}.png", "#{iconset}/icon_#{size}x#{size}.png"
      FileUtils.cp "icons/icon_#{size * 2}.png", "#{iconset}/icon_#{size}x#{size}@2x.png"
    end
    sh "iconutil -c icns #{iconset} -o #{dest}"
    FileUtils.rm_rf iconset
    true
  end

  # Developer ID with the hardened runtime when the identity is in the environment, ad-hoc
  # otherwise (a local build, or a fork without the secrets). arm64 needs *a* signature to
  # run the binary at all, but only a notarized one lets Finder hand md-boss a document that
  # still carries the download quarantine - which is why this exists.
  def sign_macos
    identity = ENV['MACOS_SIGN_IDENTITY'].to_s
    if identity.empty?
      say.yellow 'MACOS_SIGN_IDENTITY is not set - ad-hoc signing; a downloaded file will not open from Finder'
      sh "codesign --force --sign - #{BUNDLE_DIR}"
      return
    end
    sh "codesign --force --options runtime --timestamp --sign #{Shellwords.escape identity} #{BUNDLE_DIR}"
    notarize_macos
  end

  # notarytool takes a zip and wants an App Store Connect API key. The key file is the
  # secret; its path, the key id and the issuer are not, so nothing sensitive is echoed.
  # The status is read from the JSON rather than trusted to the exit code, and a rejected
  # submission prints Apple's log before it fails.
  def notarize_macos
    key_path = ENV['APPLE_API_KEY_PATH'].to_s
    key_id   = ENV['APPLE_API_KEY_ID'].to_s
    issuer   = ENV['APPLE_API_ISSUER'].to_s
    if [key_path, key_id, issuer].any?(&:empty?)
      error 'notarization needs APPLE_API_KEY_PATH, APPLE_API_KEY_ID and APPLE_API_ISSUER'
    end
    auth = "--key #{Shellwords.escape key_path} --key-id #{key_id} --issuer #{issuer}"
    FileUtils.mkdir_p 'tmp'
    zip = File.join('tmp', "#{APP_NAME}-notarize.zip")
    out = File.join('tmp', "#{APP_NAME}-notarize.json")
    # --sequesterRsrc keeps the archiver from writing AppleDouble entries notarytool flags.
    sh "ditto -c -k --keepParent --sequesterRsrc #{BUNDLE_DIR} #{zip}"
    # `|| true` because notarytool exits non-zero on a rejected submission; without it the
    # raise would skip the JSON, the status and the log below.
    sh "xcrun notarytool submit #{zip} --wait --output-format json #{auth} > #{out} || true"
    result = begin
      JSON.parse(File.read(out))
    rescue StandardError
      {}
    end
    unless result['status'] == 'Accepted'
      sh "xcrun notarytool log #{result['id']} #{auth}" if result['id']
      error "notarization was not accepted: #{result['status'] || 'no status'}"
    end
    sh "xcrun stapler staple #{BUNDLE_DIR}"
    FileUtils.rm_f [zip, out]
  end

  # The macOS bundle skeleton: plist, the binary, the PATH launcher and the payload. `dir`
  # names the .app, so `run:win` can build a throwaway Intel bundle beside the released one.
  def assemble_macos(bin, dir)
    resources = "#{dir}/Contents/Resources"
    FileUtils.rm_rf dir
    FileUtils.mkdir_p "#{dir}/Contents/MacOS"
    FileUtils.mkdir_p resources
    File.write "#{dir}/Contents/Info.plist",
               File.read('shell/Info.plist').gsub('__VERSION__', APP_VERSION)
    FileUtils.cp bin, "#{dir}/Contents/MacOS/#{BINARY_NAME}"
    # The install script puts this on PATH, pinning the bundle's real location into it.
    FileUtils.cp "bin/#{BINARY_NAME}", "#{resources}/#{BINARY_NAME}.sh"
    stage_payload resources
    build_icns "#{resources}/AppIcon.icns"
  end

  # Homebrew's rust shadows rustup's on PATH and has no cross std, and the toolchain's
  # cargo calls a bare `rustc`. Put rustup's toolchain bin first so both resolve to it.
  def rustup_toolchain_bin
    cargo = `rustup which cargo 2>/dev/null`.strip
    error 'rustup has no cargo - run `rustup toolchain install stable`' if cargo.empty?
    File.dirname cargo
  end

  def package_macos(bin, archive:)
    assemble_macos bin, BUNDLE_DIR

    sign_macos
    say.green "built ./#{BUNDLE_DIR}"
    return unless archive

    # COPYFILE_DISABLE keeps macOS from padding the tar with ._ AppleDouble entries.
    sh "COPYFILE_DISABLE=1 tar czf #{archive_name 'tar.gz'} #{BUNDLE_DIR}"
    say.green "built ./#{archive_name 'tar.gz'}"
  end

  def package_linux(bin, archive:)
    out = "out/#{BINARY_NAME}"
    FileUtils.rm_rf 'out'
    FileUtils.mkdir_p out
    FileUtils.cp bin, out
    FileUtils.cp "bin/#{BINARY_NAME}", "#{out}/#{BINARY_NAME}.sh"
    FileUtils.cp 'icons/icon_256.png', "#{out}/#{BINARY_NAME}.png" if File.exist?('icons/icon_256.png')
    stage_payload out
    say.green "built ./#{out}"
    return unless archive

    sh "tar czf #{archive_name 'tar.gz'} -C out #{BINARY_NAME}"
    say.green "built ./#{archive_name 'tar.gz'}"
  end

  def package_windows(bin, archive:)
    out = "out/#{APP_NAME}"
    FileUtils.rm_rf 'out'
    FileUtils.mkdir_p out
    FileUtils.cp bin, out
    stage_payload out
    say.green "built ./#{out}"
    return unless archive

    # Flat zip - install.ps1 expands it straight into %LOCALAPPDATA%\MdBoss.
    sh %(powershell -NoProfile -Command "Compress-Archive -Path 'out\\#{APP_NAME}\\*' ) +
       %(-DestinationPath '#{archive_name 'zip'}' -Force")
    say.green "built ./#{archive_name 'zip'}"
  end
end

helpers(&HELPERS)

task :install do
  desc 'bun install and cargo fetch - both sides of the toolchain'
  proc do
    sh 'bun install'
    sh 'cargo fetch --manifest-path shell/Cargo.toml'
  end
end

task :lint do
  desc 'tsc --noEmit and cargo clippy'
  proc do
    sh 'bun x tsc --noEmit'
    sh 'cargo clippy --quiet --manifest-path shell/Cargo.toml -- -D warnings'
  end
end

task :test do
  desc 'bun test and cargo test'
  proc do
    sh 'bun test --pass-with-no-tests'
    sh 'cargo test --quiet --manifest-path shell/Cargo.toml'
  end
end

task :server do
  desc 'Run the Bun server alone, on a fixed port, for poking at it with a WebSocket client'
  opt :port, type: :integer, default: 4800, desc: 'Port to listen on'
  proc { |opts| sh "bun server/main.ts --port #{opts[:port]} --token dev" }
end

task :dev do
  desc 'vite on 1430 plus the shell (cargo run) pointed at it - the inner loop'
  proc do
    vite = spawn('bun x vite', out: $stdout, err: $stderr)
    begin
      sh "cd shell && MDBOSS_DEV_URL=#{DEV_URL} MDBOSS_APP_DIR=#{Dir.pwd} cargo run --quiet"
    ensure
      Process.kill('TERM', vite) rescue nil
      Process.wait(vite) rescue nil
    end
  end
end

task :frontend do
  desc <<~TXT
    Build everything platform independent: dist/, the icon set, the payload tarball.
    The release pipeline runs this once and shares the result with every platform, so
    the frontend in each bundle is the same bytes.
  TXT
  proc do
    sh 'bun run build'
    hammer :icon
    hammer :payload
  end
end

task :package do
  desc <<~TXT
    Build the shell and assemble the app for the platform you are on.
    Needs dist/ - run `hammer frontend` first, or use `hammer build` for both.
  TXT
  opt :release, type: :boolean, desc: 'Optimised shell, and the release archive beside it'
  proc do |opts|
    need_frontend!
    cfg = opts[:release] ? 'release' : 'debug'
    say "packaging #{APP_NAME} #{APP_VERSION} for #{host_target} (#{cfg})", :cyan
    sh "cargo build --quiet --manifest-path shell/Cargo.toml#{opts[:release] ? ' --release' : ''}"

    bin = shell_binary(cfg)
    error "#{bin} is missing - the shell build produced nothing" unless File.file?(bin)

    case host_os
    when :macos   then package_macos   bin, archive: opts[:release]
    when :windows then package_windows bin, archive: opts[:release]
    else               package_linux   bin, archive: opts[:release]
    end
  end
end

task :build do
  desc 'Lint, test, and build both halves - the frontend and this platform package'
  opt :release, type: :boolean, desc: 'Optimised shell, and the release archives'
  proc do |opts|
    hammer :install
    hammer :lint
    hammer :test
    hammer :frontend
    hammer :package, release: opts[:release]
  end
end

task :run do
  desc 'Launch the bundle built here'
  proc do
    case host_os
    when :macos   then sh "open #{BUNDLE_DIR}"
    when :windows then sh "out\\#{APP_NAME}\\#{BINARY_NAME}.exe"
    else               sh "out/#{BINARY_NAME}/#{BINARY_NAME}"
    end
  end
end

task :install_app do
  desc "Copy the bundle into #{INSTALL_DIR} (macOS)"
  proc do
    error 'macOS only' unless host_os == :macos
    hammer :build
    `pkill -x "#{BINARY_NAME}" 2>/dev/null`
    FileUtils.rm_rf "#{INSTALL_DIR}/#{BUNDLE_DIR}"
    FileUtils.cp_r BUNDLE_DIR, INSTALL_DIR
    say.green "installed #{INSTALL_DIR}/#{BUNDLE_DIR}"
  end
end

# From "the work is committed" to "a release is building". The patch bump rides in the same
# commit as the change it ships - never a version commit of its own - and the tag is what the
# release workflow triggers on.
task :push do
  desc 'Bump the patch version, amend the last commit, push it, and tag the release'
  proc do
    branch = `git rev-parse --abbrev-ref HEAD`.strip
    error 'detached HEAD - check out a branch first' if branch == 'HEAD'
    dirty = `git status --porcelain`.split("\n").reject { |line| line.include?('package.json') }
    say.yellow "not in this push (commit them first):\n#{dirty.join("\n")}" unless dirty.empty?
    body = File.read('package.json')
    match = body.match(/"version":\s*"(\d+)\.(\d+)\.(\d+)"/) or error 'no version field in package.json'
    old = "#{match[1]}.#{match[2]}.#{match[3]}"
    version = "#{match[1]}.#{match[2]}.#{match[3].to_i + 1}"
    tag = "v#{version}"
    if `git tag -l #{tag}`.strip != '' || `git ls-remote --tags origin #{tag} 2>/dev/null`.strip != ''
      error "#{tag} already exists - nothing bumped"
    end

    say "version #{old} -> #{version}", :cyan
    File.write('package.json', body.sub(match[0], %("version": "#{version}")))
    sh 'git add package.json'
    sh 'git commit --amend --no-edit'
    sh "git push --force-with-lease origin #{branch}"
    sh "git tag -a #{tag} -m \"#{APP_NAME} #{version}\""
    sh "git push origin #{tag}"
    say.green "pushed #{branch} and #{tag} - the release workflow is building"
  end
end

task :icon do
  desc 'Regenerate icons/ from icons/AppIcon.svg - the PNG set everywhere, .icns on macOS'
  proc do
    unless tool?('rsvg-convert')
      say.yellow 'rsvg-convert not found - keeping the icons already in icons/'
      next
    end
    FileUtils.mkdir_p 'icons'
    ICON_SIZES.each do |size|
      sh "rsvg-convert -w #{size} -h #{size} icons/AppIcon.svg -o icons/icon_#{size}.png"
    end
    build_icns 'icons/icon.icns'
    say.green 'icons regenerated'
  end
end

task :payload do
  desc 'Write payload-<version>.tar.gz: server/, dist/, version.txt - what an update replaces'
  proc do
    need_frontend!
    File.write 'version.txt', "#{APP_VERSION}\n"
    name = "payload-#{APP_VERSION}.tar.gz"
    begin
      sh "tar czf #{name} #{PAYLOAD_DIRS.join ' '} version.txt"
    ensure
      FileUtils.rm_f 'version.txt'
    end
    say.green "wrote ./#{name}"
  end
end

task :link do
  desc 'Put the md-boss command on PATH: bin/md-boss copied to ~/bin'
  proc do
    FileUtils.mkdir_p File.expand_path('~/bin')
    FileUtils.install "bin/#{BINARY_NAME}", File.expand_path("~/bin/#{BINARY_NAME}"), mode: 0o755
    say.green "installed ~/bin/#{BINARY_NAME}"
  end
end

task :demo do
  desc 'Serve the repo and open the demo page'
  proc do
    # Served from the repo root rather than web-demo/, so the page can point at the app
    # icon where it actually lives.
    say 'serving http://localhost:8000/web-demo/', :cyan
    `open http://localhost:8000/web-demo/`
    sh 'python3 -m http.server 8000'
  end
end

# Not a release path: the one way to run the Intel slice on an Apple Silicon machine. It
# reuses the same arch-independent payload the released bundle carries and ad-hoc signs the
# throwaway app, so Rosetta will load it.
namespace :run do
  # A namespace is a separate subclass of Hammer, so it does not see the helpers defined
  # at the top of this file. Run the same definitions against this class.
  class_eval(&HELPERS)

  task :win do
    desc 'Build the shell for x86_64 and launch it under Rosetta (macOS)'
    opt :release, type: :boolean, desc: 'Optimised shell'
    proc do |opts|
      error 'run:win is macOS only' unless host_os == :macos
      error 'rustup not found - cross-building needs it: brew install rustup' unless tool?('rustup')
      installed = `rustup target list --installed 2>/dev/null`
      error 'x86_64 target missing - run `rustup target add x86_64-apple-darwin`' unless installed.include?('x86_64-apple-darwin')

      need_frontend!
      cfg = opts[:release] ? 'release' : 'debug'
      say "building md-boss for x86_64 (#{cfg})", :cyan
      path = ENV.fetch('PATH', '')
      ENV['PATH'] = "#{rustup_toolchain_bin}:#{path}"
      begin
        sh "cargo build --quiet --manifest-path shell/Cargo.toml --target x86_64-apple-darwin#{opts[:release] ? ' --release' : ''}"
      ensure
        ENV['PATH'] = path
      end

      dir = "#{APP_NAME}-x86.app"
      assemble_macos File.join('shell', 'target', 'x86_64-apple-darwin', cfg, BINARY_NAME), dir
      # Rosetta refuses an unsigned Intel binary; ad-hoc is enough for a local test.
      sh "codesign --force --sign - #{dir}"
      say.green "launching ./#{dir} under Rosetta - quit it to come back here"
      sh "arch -x86_64 #{dir}/Contents/MacOS/#{BINARY_NAME}"
    end
  end
end
