<script>
  // Asset names carry no version, so latest/download always resolves to the newest build.
  const DOWNLOAD = 'https://github.com/dux/md-boss/releases/latest/download/'
  const INSTALL_SH = 'curl -fsSL https://raw.githubusercontent.com/dux/md-boss/main/install.sh | sh'

  class {
    FAST = true

    init() {
      this.state.open = false
      this.state.copied = null
      // macOS rows copy the script rather than link the archive: the build is not notarized,
      // and a browser download carries the quarantine flag macOS refuses it for.
      this.state.items = [
        { id: 'darwin-arm64', label: 'macOS (Apple Silicon)', note: 'Copies the install command for Terminal', icon: 'assets/platform/macos.png', copy: true, href: '#install' },
        { id: 'darwin-x64', label: 'macOS (Intel)', note: 'Copies the install command for Terminal', icon: 'assets/platform/macos.png', copy: true, href: '#install' },
        { id: 'windows-x64', label: 'Windows 10/11 (x64)', note: 'Zip - unzip anywhere and run md-boss.exe', icon: 'assets/platform/windows.png', href: DOWNLOAD + 'md-boss-windows-x64.zip' },
        { id: 'windows-arm64', label: 'Windows 11 (ARM64)', note: 'Zip - the native build for ARM PCs', icon: 'assets/platform/windows.png', href: DOWNLOAD + 'md-boss-windows-arm64.zip' },
        { id: 'linux-x64', label: 'Linux x64', note: 'Tarball - needs WebKitGTK 4.1', icon: 'assets/platform/linux.svg', href: DOWNLOAD + 'md-boss-linux-x64.tar.gz' },
        { id: 'linux-arm64', label: 'Linux ARM64', note: 'Tarball - needs WebKitGTK 4.1', icon: 'assets/platform/linux.svg', href: DOWNLOAD + 'md-boss-linux-arm64.tar.gz' },
        { id: 'terminal', label: 'Install from the terminal', note: 'One line per OS, checksum checked', href: '#install', sep: true }
      ]
    }

    onMount() {
      this.on(document, 'click', (e) => {
        if (this.state.open && !this.root.contains(e.target)) this.close()
      })
      this.on(document, 'keydown', (e) => {
        if (e.key === 'Escape') this.close()
      })
    }

    toggle() {
      this.state.open = !this.state.open
    }

    close() {
      this.state.open = false
      this.state.copied = null
    }

    pick(event, id) {
      const item = this.state.items.find((it) => it.id === id)
      if (!item.copy) return this.close()

      event.preventDefault()
      navigator.clipboard.writeText(INSTALL_SH).then(() => {
        this.state.copied = id
        clearTimeout(this.state.copyTimer)
        this.state.copyTimer = setTimeout(() => { this.state.copied = null }, 2000)
      }, () => {
        // No clipboard (insecure origin, denied permission) - show the command instead.
        this.close()
        location.hash = 'install'
      })
    }
  }
</script>

<style>
  display: inline-block;
  position: relative;
  z-index: 30;
  --menu-w: min(400px, calc(100vw - 32px));

  .trigger {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 52px;
    width: min(340px, calc(100vw - 32px));
    min-height: 60px;
    border-radius: 999px;
    overflow: hidden;
    background: var(--accent);
    color: var(--paper);
    box-shadow: 0 14px 36px rgba(43, 39, 35, 0.22);
    transition: background 0.16s ease, box-shadow 0.16s ease;

    &:hover {
      background: var(--accent-hover);
      box-shadow: 0 18px 44px rgba(43, 39, 35, 0.28);
    }

    button {
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      cursor: pointer;

      &:focus-visible {
        outline: 2px solid var(--paper);
        outline-offset: -4px;
        border-radius: 999px;
      }
    }

    .chevron {
      border-left: 1px solid color-mix(in srgb, var(--paper) 28%, transparent);
    }

    svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }

  .primary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 0 22px;
    text-align: left;

    svg { width: 26px; height: 26px; }

    strong {
      display: block;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.2;
    }

    small {
      display: block;
      font-size: 12px;
      opacity: 0.78;
    }
  }

  .chevron {
    display: grid;
    place-items: center;

    svg {
      width: 18px;
      height: 18px;
      transition: transform 0.16s ease;
    }
  }

  .open .chevron svg {
    transform: rotate(180deg);
  }

  .menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    margin-left: calc(var(--menu-w) / -2);
    width: var(--menu-w);
    display: grid;
    padding: 6px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 14px;
    box-shadow: 0 26px 60px rgba(43, 39, 35, 0.2);
    text-align: left;
  }

  .row {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) 18px;
    gap: 12px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 9px;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.16s ease;

    &:hover {
      background: var(--surface);
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }

    img, .glyph {
      width: 20px;
      height: 20px;
    }

    strong {
      display: block;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.3;
    }

    small {
      display: block;
      font-size: 12px;
      line-height: 1.35;
      color: var(--muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .action {
      width: 18px;
      height: 18px;
      color: var(--muted);
      transition: color 0.16s ease;
    }

    &:hover .action {
      color: var(--accent);
    }

    &.copied small,
    &.copied .action {
      color: var(--alert-tip);
    }
  }

  .sep {
    margin-top: 6px;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: -4px;
      left: 12px;
      right: 12px;
      border-top: 1px solid var(--rule);
    }
  }
</style>

<div class="install" class:open={state.open}>
  <div class="trigger">
    <button type="button" class="primary" aria-haspopup="menu" aria-controls="install-menu" aria-expanded={state.open ? 'true' : 'false'} onclick="fez.toggle()">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
      <span>
        <strong>Install md-boss</strong>
        <small>Choose your platform</small>
      </span>
    </button>
    <button type="button" class="chevron" aria-haspopup="menu" aria-controls="install-menu" aria-expanded={state.open ? 'true' : 'false'} aria-label="Show install options" onclick="fez.toggle()">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
  </div>
  {#if state.open}
    <div class="menu" id="install-menu" role="menu" aria-label="Install options" fez:in="fly, y=-6, duration=160">
      {#each state.items as item}
        <a href={item.href} role="menuitem" class={'row' + (item.sep ? ' sep' : '') + (state.copied === item.id ? ' copied' : '')} onclick="fez.pick(event, '{item.id}')">
          {#if item.icon}
            <img src={item.icon} alt="" aria-hidden="true" width="20" height="20" />
          {:else}
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>
          {/if}
          <span>
            <strong>{item.label}</strong>
            <small>{state.copied === item.id ? 'Copied - paste it into Terminal' : item.note}</small>
          </span>
          {#if state.copied === item.id}
            <svg class="action" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          {:else if item.copy}
            <svg class="action" viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          {:else if item.sep}
            <svg class="action" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          {:else}
            <svg class="action" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          {/if}
        </a>
      {/each}
    </div>
  {/if}
</div>
