    font: inherit;
    width: 1em;
    height: 1em;
    margin: 0 0.45em 0 -1.45em;
    vertical-align: -0.12em;
  }

  .box {
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    border: 1.5px solid var(--border-strong, #CFC4AE);
    border-radius: 0.25em;
    background: transparent;
  }

  .box.done {
    background: var(--accent, #9A5B34);
    border-color: var(--accent, #9A5B34);
  }

  .box.done::after {
    content: "";
    position: absolute;
    left: 0.29em;
    top: 0.1em;
    width: 0.2em;
    height: 0.44em;
    border: solid var(--paper, #FBF7EF);
    border-width: 0 0.13em 0.13em 0;
    transform: rotate(43deg);
  }

  .spinner { overflow: visible; }

  .spinner-track {
    fill: none;
    stroke: var(--border-strong, #CFC4AE);
    stroke-width: 2;
  }

  .spinner-head {
    fill: none;
    stroke: var(--accent, #9A5B34);
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: 50% 50%;
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .spinner-head { animation: none; }
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
