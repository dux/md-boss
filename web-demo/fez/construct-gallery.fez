    padding: 0.1em 0 0.1em 1.1em;
    border-left: 3px solid var(--alert);
    color: var(--ink, #2B2723);
  }

  .alert.tip { --alert: var(--alert-tip, #4C6B3C); }
  .alert.important { --alert: var(--alert-important, #6D4C9F); }
  .alert.warning { --alert: var(--alert-warning, #8A5A20); }
  .alert.caution { --alert: var(--alert-caution, #A03E52); }

  .alert-title {
    margin: 0 0 0.2em;
    font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    font-size: 0.75em;
