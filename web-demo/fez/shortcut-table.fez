<script>
  class {
    FAST = true

    init() {
      this.state.groups = [
        { name: 'Panes and layout', rows: [
          { keys: ['⌘1', '⌘2', '⌘3', '⌘4'], what: 'fold the files, preview, raw and notes panels in or out' },
          { keys: ['⌘←', '⌘→'], what: 'narrow and widen the reading column' },
          { keys: ['⌘\\'], what: 'raw and preview side by side' },
          { keys: ['⇧⌘D'], what: 'switch between light and dark, keeping Default or Compact' },
          { keys: ['⌘+', '⌘-', '⌥⌘0'], what: 'text size; ⌥⌘0 also resets the column width' }
        ]},
        { name: 'Files', rows: [
          { keys: ['⌘N'], what: 'new file in the sidebar folder' },
          { keys: ['⌘O'], what: 'add folders to the sidebar' },
          { keys: ['⇧⌘O'], what: 'open a single file' },
          { keys: ['⇧⌘R'], what: 'reveal the selection in Finder, Explorer or the file manager' },
          { keys: ['⌘⌫'], what: 'move the selected file to the Trash' },
          { keys: ['⌘S'], what: 'save' },
          { keys: ['⎋'], what: 'cancel a pending Cut in the sidebar' }
        ]},
        { name: 'Find and format', rows: [
          { keys: ['⇧⌘F'], what: 'find in every document under the sidebar folder' },
          { keys: ['⌘P'], what: 'go to a file by name' },
          { keys: ['⌘F'], what: 'find in the open document' },
          { keys: ['⌘B', '⌘I'], what: 'bold or italic the selection, or the word under the caret' },
          { keys: ['⌘K'], what: 'make a link - a URL on the clipboard becomes the destination' }
        ]},
        { name: 'Notes and navigation', rows: [
          { keys: ['⇧⌘K'], what: 'add or edit a note on the current line' },
          { keys: ['⇧⌘⌫'], what: 'delete the note on the current line' },
          { keys: ['⌫', '⌘['], what: 'go back to the document you came from' },
          { keys: ['↑', '↓', '←', '→'], what: 'move through the sidebar - or type a name to jump to it' }
        ]}
      ]
    }
  }
</script>

<style>
  display: block;
  overflow-x: auto;

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  tr.group td {
    padding: 20px 18px 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #948A7C;
  }

  tr.row {
    border-bottom: 1px solid #EFE7D6;
  }

  tr.row:hover td {
    background: #F6F0E4;
  }

  td.keys {
    width: 230px;
    padding: 11px 18px;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    td.keys {
      width: 38%;
      white-space: normal;
      padding: 11px 10px 11px 14px;
    }

    td.what { padding: 11px 14px 11px 8px; }

    kbd { margin-bottom: 4px; }
  }

  td.what {
    padding: 11px 18px;
    color: #4A443D;
  }

  kbd {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #2B2723;
    background: #F3EDE1;
    border: 1px solid #E3D9C6;
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 2px 7px;
    margin-right: 4px;
  }
</style>

<table>
  <tbody>
    {#each state.groups as g}
      <tr class="group">
        <td colspan="2">{g.name}</td>
      </tr>
      {#each g.rows as row}
        <tr class="row">
          <td class="keys">
            {#each row.keys as k}
              <kbd>{k}</kbd>
            {/each}
          </td>
          <td class="what">{row.what}</td>
        </tr>
      {/each}
    {/each}
  </tbody>
</table>
