<script>
  class {
    FAST = true

    init() {
      // Copied out of src/theme/theme.ts, which is the only place in the app
      // a hex literal is allowed to live. Compact reuses the same palette and
      // only changes density, so the two compact cards draw tighter type rather
      // than a different colour.
      this.state.themes = [
        { name: 'Default Light', id: 'paper', compact: false, bg: '#FBF7EF', surface: '#F3EDE1', border: '#E3D9C6', text: '#2B2723', muted: '#756C61', accent: '#9A5B34' },
        { name: 'Default Dark', id: 'dark', compact: false, bg: '#1E1C1A', surface: '#26231F', border: '#38342E', text: '#E6E0D6', muted: '#9A9287', accent: '#E0996A' },
        { name: 'Compact Light', id: 'compact-light', compact: true, bg: '#FBF7EF', surface: '#F3EDE1', border: '#E3D9C6', text: '#2B2723', muted: '#756C61', accent: '#9A5B34' },
        { name: 'Compact Dark', id: 'compact-dark', compact: true, bg: '#1E1C1A', surface: '#26231F', border: '#38342E', text: '#E6E0D6', muted: '#9A9287', accent: '#E0996A' }
      ]
    }
  }
</script>

<style>
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;

  @media (min-width: 768px) {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .swatch {
    border-radius: 12px;
    padding: 16px;
    border: 1px solid;
    transition: transform 0.2s ease, box-shadow 0.2s ease;

    &:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 26px rgba(43, 39, 35, 0.14);
    }
  }

  .rule {
    height: 3px;
    width: 30px;
    border-radius: 2px;
    margin-bottom: 12px;
  }

  .name {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .line {
    height: 6px;
    border-radius: 3px;
    margin-bottom: 6px;
    opacity: 0.55;
  }

  .line.short {
    width: 62%;
  }

  .swatch.compact {
    .name { font-size: 13px; margin-bottom: 6px; }
    .line { height: 5px; margin-bottom: 4px; }
    .rule { margin-bottom: 8px; }
  }

  .chip {
    margin-top: 12px;
    border-radius: 6px;
    border: 1px solid;
    padding: 5px 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
  }

  .swatch.compact .chip {
    margin-top: 8px;
    padding: 3px 6px;
    font-size: 10px;
  }
</style>

{#each state.themes as t}
  <div class={t.compact ? 'swatch compact' : 'swatch'} style={'background: ' + t.bg + '; border-color: ' + t.border}>
    <div class="rule" style={'background: ' + t.accent}></div>
    <div class="name" style={'color: ' + t.text}>{t.name}</div>
    <div class="line" style={'background: ' + t.text}></div>
    <div class="line" style={'background: ' + t.muted}></div>
    <div class="line short" style={'background: ' + t.muted}></div>
    <div class="chip" style={'background: ' + t.surface + '; border-color: ' + t.border + '; color: ' + t.accent}>{t.id}</div>
  </div>
{/each}
