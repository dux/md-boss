<script>
  // The Toast overlay (ToastView.swift): one message at a time, floating just above the
  // footer in the middle of the window, gone on its own or on a click. The manager's toast
  // model (src/models/toast.ts) owns the timing; this only draws what it holds. A glyph per
  // kind stands in for the SF Symbols - info circle, check circle, warning triangle.
  class {
    init() {
      this.state.message = null
    }

    onMount() {
      this.local.unsubscribe = MdBoss.manager.toast.onChange((message) => {
        this.state.message = message
      })
      this.state.message = MdBoss.manager.toast.current
    }

    onDestroy() {
      if (this.local.unsubscribe) this.local.unsubscribe()
    }

    dismiss() {
      MdBoss.manager.toast.dismiss()
    }

    // The button's click also bubbles to the toast, which dismisses it - the decision is
    // made, the message has no further business on screen.
    act() {
      const action = MdBoss.manager.toast.current?.action
      if (action) action.run()
    }
  }
</script>

<style>
  /* Over everything, taking no clicks itself - only the message does. */
  position: fixed;
  left: 0;
  right: 0;
  bottom: 34px;
  display: flex;
  justify-content: center;
  pointer-events: none;
  z-index: 50;

  /* Stable root + hidden class, not an {#if} around everything - see change-banner. */
  .toast.hidden {
    display: none;
  }

  .toast {
    display: flex;
    align-items: center;
    gap: 7px;
    max-width: min(560px, calc(100% - 48px));
    padding: 9px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.18);
    pointer-events: auto;
    animation: toast-in 0.18s ease-out;
  }

  /* An error speaks in the accent, frame and all, the way the Swift view tinted it. */
  .toast.error {
    border-color: var(--accent);
    color: var(--accent);
  }

  .toast svg {
    flex: none;
    width: 1.1em;
    height: 1.1em;
  }

  /* The message's one button, "Restart to update": filled with the link colour, as the
     prompt panel's primary button is. */
  .toast .action {
    flex: none;
    margin-left: 4px;
    padding: 3px 10px;
    border: 1px solid var(--link);
    border-radius: 5px;
    background: var(--link);
    color: var(--bg);
    font-family: inherit;
    font-weight: 600;
  }

  .toast .text {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<div class={'toast text-buttons pointer ' + (state.message ? state.message.kind : 'hidden')} fez:keep={'toast-' + (state.message ? state.message.id : 'none')} title="Click to dismiss" onclick="fez.dismiss()">
  {#if state.message}
    {#if state.message.kind === 'error'}
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M8 2.2L14.6 13.5H1.4z"></path><path d="M8 6.2v3.6" stroke-linecap="round"></path><circle cx="8" cy="11.7" r="0.6" fill="currentColor" stroke="none"></circle></svg>
    {:else if state.message.kind === 'success'}
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.3"></circle><path d="M5.2 8.3l1.9 1.9 3.7-4"></path></svg>
    {:else}
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="8" cy="8" r="6.3"></circle><path d="M8 7.2v4"></path><circle cx="8" cy="4.9" r="0.6" fill="currentColor" stroke="none"></circle></svg>
    {/if}
    <span class="text">{state.message.text}</span>
    {#if state.message.action}
      <button class="action text-buttons pointer" onclick="fez.act()">{state.message.action.label}</button>
    {/if}
  {/if}
</div>
