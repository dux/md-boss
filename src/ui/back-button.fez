<script>
  // Back to the document you were reading before this one. It sits in the rendered panel's
  // label strip: following a link is something you do in the rendered page, so the way back
  // belongs to that panel. Hidden rather than disabled when there is no history - a
  // permanently dead control is just noise. Cmd-[ works either way.
  class {
    init() {
      this.state.target = null
    }

    onMount() {
      this.local.unsubscribe = MdBoss.manager.onChange(() => this.pull())
      this.pull()
    }

    onDestroy() {
      if (this.local.unsubscribe) this.local.unsubscribe()
    }

    pull() {
      const target = MdBoss.manager.backTarget
      this.state.target = target ? target.slice(target.lastIndexOf('/') + 1) : null
    }

    back() {
      MdBoss.manager.goBack()
    }
  }
</script>

<style>
  display: block;

  /* Stable root + hidden class, not an {#if} around everything - see change-banner. */
  .back.hidden {
    display: none;
  }

  /* A light button, the same face the other two controls in this strip wear. bg and not
     surface: the strip is already surface, and in the paper palette the two are the same
     hex - a surface button on it would have no edges at all. Sized in border-box so the
     border does not push it past the rail. */
  button {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 4px;
    height: calc(var(--font-buttons) + 8px);
    padding: 0 7px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--muted);
    font-family: inherit;
    white-space: nowrap;
  }

  button:hover {
    border-color: var(--border-strong);
    background: var(--selection);
    color: var(--text);
  }

  button .chevron {
    font-size: 0.8em;
    font-weight: 600;
  }
</style>

<div class={'back' + (state.target ? '' : ' hidden')}>
  {#if state.target}
    <button class="text-buttons pointer" title={'Back to ' + state.target + ' (⌫)'} onclick="fez.back()"><span class="chevron">‹</span> go back</button>
  {/if}
</div>
