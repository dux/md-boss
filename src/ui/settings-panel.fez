<script>
  // The Settings panel, in-window: the theme grid and the four text sizes. Hand-rolled
  // rather than system controls so it draws in the paper palette like everything else.
  // Every change writes straight through the settings store, so the window restyles live
  // behind the panel - the chrome through the --font-* vars, the editor through
  // setFontSize, the preview through mdSetTheme / mdSetFontSize.
  class {
    init() {
      this.state.open = false
      this.state.activeID = null
      this.state.themes = []
      this.state.sizes = []
      this.state.isDefault = true
    }

    onMount() {
      this.local.unsubscribe = [
        MdBoss.panels.onToggle((panel) => {
          if (panel === 'settings') this.state.open = !this.state.open
        }),
        MdBoss.manager.settings.onChange(() => this.pull()),
      ]
      // Escape closes, in the capture phase so the tree behind it does not see the key.
      this.on(document, 'keydown', (event) => {
        if (!this.state.open || event.key !== 'Escape') return
        event.preventDefault()
        event.stopPropagation()
        this.state.open = false
      }, { capture: true })
      this.pull()
    }

    onDestroy() {
      for (const off of this.local.unsubscribe || []) off()
    }

    pull() {
      const manager = MdBoss.manager
      const active = manager.theme
      this.state.activeID = active.id
      // One theme, painted in its own palette - the grid is a preview, not a list of names.
      this.state.themes = MdBoss.THEMES.map((theme) => ({
        id: theme.id,
        title: theme.title,
        bg: theme.hex.bg,
        text: theme.hex.text,
        chips: [theme.hex.surface, theme.hex.accent, theme.hex.link],
        isSelected: theme.id === active.id,
      }))
      this.state.sizes = MdBoss.FONT_SETTINGS.map((setting) => ({
        id: setting.id,
        title: setting.title,
        detail: setting.detail,
        value: manager.fontSize(setting),
        canShrink: manager.canChangeFontSize(setting, -1),
        canGrow: manager.canChangeFontSize(setting, 1),
      }))
      this.state.isDefault = manager.fontSizesAreDefault
    }

    close() {
      this.state.open = false
    }

    pick(id) {
      MdBoss.manager.setTheme(id)
    }

    step(id, delta) {
      const setting = MdBoss.FONT_SETTINGS.find((s) => s.id === id)
      if (setting && MdBoss.manager.canChangeFontSize(setting, Number(delta))) MdBoss.manager.changeFontSize(setting, Number(delta))
    }

    reset() {
      MdBoss.manager.resetFontSizes()
    }
  }
</script>

<style>
  display: block;

  /* Stable root + hidden class, not an {#if} around everything - see change-banner. */
  .overlay.hidden {
    display: none;
  }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
  }

  .panel {
    width: 360px;
    box-sizing: border-box;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--bg);
    box-shadow: 0 8px 30px var(--border-strong);
  }

  hr {
    margin: 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  /* Three across fits all eight cards in three rows. */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px 10px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--muted);
  }

  .card.selected {
    color: var(--text);
  }

  /* The selection ring belongs to the window's chrome, so it is drawn in the *active*
     theme's accent rather than the card's. */
  .swatch {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    text-align: left;
  }

  .card.selected .swatch {
    border: 2px solid var(--accent);
    padding: 7px;
  }

  .chips {
    display: flex;
    gap: 4px;
  }

  .chips span {
    flex: 1;
    height: 8px;
    border-radius: 2px;
  }

  .aa {
    font-weight: 600;
  }

  .card .name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .row .labels {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .row .labels .detail {
    color: var(--muted);
  }

  /* Matches the chrome of the measure arrows - same radius, border, plain buttons. */
  .stepper {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    overflow: hidden;
  }

  .stepper button {
    width: 26px;
    height: 24px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-weight: 600;
  }

  .stepper button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .stepper .value {
    width: 30px;
    text-align: center;
    color: var(--text);
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    line-height: 16px;
  }

  .foot {
    display: flex;
    justify-content: flex-end;
  }

  .foot button {
    border: 0;
    background: transparent;
    color: var(--link);
    font: inherit;
  }

  .foot button:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>

<div class={'overlay' + (state.open ? '' : ' hidden')} onclick!="fez.close()">
  {#if state.open}
    <div class="panel">
      <div class="text-title">Theme</div>
      <div class="grid">
        {#each state.themes as theme}
          <button class={'card pointer' + (theme.isSelected ? ' selected' : '')} title={theme.title} onclick="fez.pick('{theme.id}')">
            <span class="swatch" style="background: {theme.bg}">
              <span class="chips"><span style="background: {theme.chips[0]}"></span><span style="background: {theme.chips[1]}"></span><span style="background: {theme.chips[2]}"></span></span>
              <span class="aa text-small" style="color: {theme.text}">Aa</span>
            </span>
            <span class="name text-small">{theme.title}</span>
          </button>
        {/each}
      </div>
      <hr>
      <div class="text-title">Font size</div>
      <div class="rows">
        {#each state.sizes as size}
          <div class="row">
            <div class="labels">
              <span class="text-default">{size.title}</span>
              <span class="detail text-small">{size.detail}</span>
            </div>
            <div class="stepper text-buttons">
              <button class="pointer" title="Smaller" disabled={!size.canShrink} onclick="fez.step('{size.id}', -1)">−</button>
              <span class="value text-small text-mono">{size.value}</span>
              <button class="pointer" title="Bigger" disabled={!size.canGrow} onclick="fez.step('{size.id}', 1)">+</button>
            </div>
          </div>
        {/each}
      </div>
      <hr>
      <div class="foot">
        <button class="text-buttons pointer" disabled={state.isDefault} onclick="fez.reset()">Reset to defaults</button>
      </div>
    </div>
  {/if}
</div>
