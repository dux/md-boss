<script>
  // The rendered document. Lives in an iframe (srcdoc) so the page's CSP and the
  // vendored scripts stay isolated from the app; the first render loads the page, later
  // ones call mdRender on the iframe's window so scroll position survives. Opening or
  // reloading a file shows immediately; typing is debounced 250 ms.
  const TYPING_DELAY = 250

  class {
    init() {
      this.local.loaded = false
      this.local.pending = null
      this.local.pendingCompletions = []
      this.local.path = null
      this.local.reloadToken = -1
      this.local.taskCompletionID = 0
      this.local.typing = null
      // Where to land once the next render is in: the remembered place of a file that
      // just arrived. Restored after the render, which is when the page has anchors.
      this.local.restoreTo = null
    }

    onMount() {
      this.local.onMessage = (event) => {
        if (event.source !== this.frame.contentWindow) return
        const msg = event.data || {}
        if (msg.kind === 'error') console.error('preview page:', msg.message)
        if (msg.kind === 'link') void MdBoss.manager.followLink(msg.href)
        if (msg.kind === 'anchorMiss') MdBoss.manager.showError('No heading: ' + msg.id)
        if (msg.kind === 'ready') {
          this.local.loaded = true
          if (this.local.pending !== null) {
            this.render(this.local.pending, this.local.pendingCompletions)
          }
          this.followAnchorRequest()
        }
        // The page suppresses its own echo after mdScrollToLine, so what arrives here is
        // the reader scrolling. Recorded before the sync and unconditionally: the sync
        // drops the move unless both panes are up, and where the reader is has to be
        // remembered either way.
        if (msg.kind === 'scroll') {
          if (this.local.path) MdBoss.manager.scrollMemory.recordLine(this.local.path, msg.line)
          MdBoss.manager.scrollSync.report(msg.line, 'preview', performance.now())
        }
        // A right-click on a block: the page says which source line, and where, in its
        // own coordinates - the iframe's offset puts the menu under the pointer.
        if (msg.kind === 'context') this.contextMenu(msg)
        if (msg.kind === 'key') this.replayKey(msg)
      }
      window.addEventListener('message', this.local.onMessage)
      this.local.unsubscribe = [
        MdBoss.manager.scrollSync.onMove((move) => {
          if (move.source === 'preview' || !this.local.loaded) return
          this.frame.contentWindow.mdScrollToLine(move.line)
          MdBoss.manager.scrollSync.applied(performance.now())
        }),
        MdBoss.manager.onChange(() => this.pull()),
        MdBoss.manager.notes.onChange(() => this.pushNotes()),
        MdBoss.manager.onCursorChange(() => this.pushHighlight()),
        MdBoss.components.onChange(() => this.reloadComponents()),
        // Told which theme to use, never left to prefers-color-scheme: the page swaps its
        // <style id=theme> in place, so the scroll position and the rendered DOM survive.
        MdBoss.manager.settings.onChange((data) => {
          if (data.themeID !== this.local.themeID) {
            this.local.themeID = data.themeID
            if (this.local.loaded) this.frame.contentWindow.mdSetTheme(MdBoss.rootCSS(MdBoss.themeNamed(data.themeID)))
          }
          if (data.previewFontSize !== this.local.fontSize) {
            this.local.fontSize = data.previewFontSize
            if (this.local.loaded) this.frame.contentWindow.mdSetFontSize(data.previewFontSize)
          }
          if (data.previewMeasure !== this.local.measure) {
            this.local.measure = data.previewMeasure
            if (this.local.loaded) this.frame.contentWindow.mdSetMeasure(data.previewMeasure)
          }
        }),
      ]
      const data = MdBoss.manager.settings.data
      this.local.themeID = data.themeID
      this.local.fontSize = data.previewFontSize
      this.local.measure = data.previewMeasure
      this.pull()
    }

    onDestroy() {
      window.removeEventListener('message', this.local.onMessage)
      for (const off of this.local.unsubscribe || []) off()
      if (this.local.typing) clearTimeout(this.local.typing)
    }

    pushNotes() {
      if (!this.local.loaded || !this.local.path) return
      const map = {}
      for (const [line, text] of MdBoss.manager.notes.noteTexts(this.local.path)) map[String(line)] = text
      this.frame.contentWindow.mdSetNotes(map)
    }

    pushHighlight() {
      if (!this.local.loaded) return
      const line = MdBoss.manager.highlightedLine
      if (line === this.local.highlighted) return
      this.local.highlighted = line
      this.frame.contentWindow.mdHighlightLine(line)
    }

    // A shortcut pressed while the reader's focus was in the page. Replayed on our own
    // window, so keys.ts and the menu see it exactly as they would have with the app in
    // focus. In the shell the bar has already answered whatever it registered natively,
    // and handleKey skips those, so nothing is done twice.
    replayKey(msg) {
      window.dispatchEvent(new KeyboardEvent('keydown', {
        code: msg.code,
        key: msg.key,
        metaKey: msg.metaKey,
        ctrlKey: msg.ctrlKey,
        altKey: msg.altKey,
        shiftKey: msg.shiftKey,
        bubbles: true,
        cancelable: true,
      }))
    }

    contextMenu(msg) {
      const manager = MdBoss.manager
      const doc = manager.document
      if (!doc) return
      manager.reportCursorLine(msg.line)
      const box = this.frame.getBoundingClientRect()
      const hasNote = manager.hasNoteAtCursor
      MdBoss.menus.open(box.left + (msg.x || 0), box.top + (msg.y || 0), [
        { label: hasNote ? 'Edit Note…' : 'Add Note…', action: () => manager.addNoteAtCursor() },
        { separator: true },
        { label: 'Copy Path', action: () => manager.copyText(doc.path, 'Path copied') },
        { label: 'Copy Path with Line', action: () => manager.copyText(manager.notes.key(doc.path) + ':' + msg.line, 'Path copied') },
        { label: MdBoss.revealLabel, action: () => manager.showInFileManager(doc.path) },
      ])
    }

    /** A link asked for a heading. One-shot by id, and applied only once the document it
     *  names is rendered - so it waits out a page still loading or a render still pending. */
    followAnchorRequest() {
      const request = MdBoss.manager.anchorRequest
      if (!request || request.seq === this.local.anchorSeq) return
      if (!this.local.loaded || this.local.pending !== null) return
      this.local.anchorSeq = request.seq
      this.frame.contentWindow.mdScrollToAnchor(request.id)
    }

    pull() {
      const doc = MdBoss.manager.document
      // A delimited file is csv-pane's; the page keeps the last markdown document, hidden.
      if (!doc || MdBoss.documentKind(doc.path) !== 'markdown') return
      this.pushHighlight()
      const fresh = doc.path !== this.local.path || doc.reloadToken !== this.local.reloadToken
      if (fresh) {
        if (this.local.typing) clearTimeout(this.local.typing)
        this.local.typing = null
        const sameDocument = doc.path === this.local.path
        if (!sameDocument) {
          this.local.restoreTo = MdBoss.manager.scrollMemory.place(doc.path).line ?? 1
        }
        const completion = doc.taskCompletion
        const completed = sameDocument && completion && completion.id !== this.local.taskCompletionID
          ? completion.indexes
          : []
        this.local.path = doc.path
        this.local.reloadToken = doc.reloadToken
        this.local.taskCompletionID = completion?.id ?? 0
        this.render(this.source(doc), completed)
        this.followAnchorRequest()
        return
      }
      this.followAnchorRequest()
      if (this.local.typing) clearTimeout(this.local.typing)
      this.local.typing = setTimeout(() => {
        this.local.typing = null
        const current = MdBoss.manager.document
        if (current && current.path === this.local.path) this.render(this.source(current))
      }, TYPING_DELAY)
    }

    /** The page's <base> follows the file on screen, so its relative links and images
     *  resolve against that file and not the one the page was first built for. */
    pushBase() {
      if (!this.local.path || this.local.path === this.local.basePath) return
      this.local.basePath = this.local.path
      this.frame.contentWindow.mdSetBase(MdBoss.documentBaseURL(this.local.path))
    }

    /** Component classes and their scoped CSS live in the iframe. Replacing srcdoc gives
     *  an edited class a clean registry and drops CSS that a removed component injected. */
    reloadComponents() {
      const doc = MdBoss.manager.document
      if (!doc || MdBoss.documentKind(doc.path) !== 'markdown') return
      if (this.local.typing) clearTimeout(this.local.typing)
      this.local.typing = null
      this.local.restoreTo = MdBoss.manager.scrollMemory.place(doc.path).line ?? 1
      this.local.loaded = false
      this.local.pending = null
      this.local.pendingCompletions = []
      this.local.basePath = doc.path
      this.render(this.source(doc))
    }

    /** What the page renders for a document: markdown as it is, JSON inside a fence so it
     *  reads as code rather than as one long paragraph. */
    source(doc) {
      if (!doc.path.toLowerCase().endsWith('.json')) return doc.text
      const fence = doc.text.includes('```') ? '````' : '```'
      return `${fence}json\n${doc.text}\n${fence}\n`
    }

    render(markdown, completed = []) {
      if (this.local.loaded) {
        this.local.pending = null
        this.local.pendingCompletions = []
        this.pushBase()
        this.frame.contentWindow.mdRender(markdown, MdBoss.typedBlocks(markdown), completed)
        this.pushNotes()
        if (this.local.restoreTo !== null) {
          this.frame.contentWindow.mdScrollToLine(this.local.restoreTo)
          this.local.restoreTo = null
        }
        return
      }
      if (this.local.pending !== null) {
        // page still loading - the latest text wins when it says ready
        this.local.pending = markdown
        this.local.pendingCompletions = completed
        return
      }
      this.local.pending = markdown
      this.local.pendingCompletions = completed
      this.local.basePath = this.local.path
      this.frame.srcdoc = MdBoss.buildPreviewPage({
        markdown,
        themeCSS: MdBoss.rootCSS(MdBoss.manager.theme),
        fontSize: MdBoss.manager.settings.data.previewFontSize,
        measure: MdBoss.manager.settings.data.previewMeasure,
        baseURL: this.local.path ? MdBoss.documentBaseURL(this.local.path) : null,
        assetBase: MdBoss.native().shell.assetBase(),
        components: MdBoss.components.items,
        typedBlocks: MdBoss.typedBlocks(markdown),
      })
    }
  }
</script>

<style>
  display: flex;
  flex-direction: column;
  height: 100%;

  /* Below the banner, so the page is pushed down by it rather than covered. Back and the
     measure arrows live in the panel's label strip now, not over the text. */
  .page {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--bg);
  }

</style>

<change-banner></change-banner>
<div class="page">
  <iframe fez:this="frame" title="preview" sandbox="allow-scripts allow-same-origin"></iframe>
</div>
