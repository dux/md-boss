<script>
  // A row the chat was pointed at, as a chip: its lines, and its first words to tell two apart.
  const chip = (a) => ({
    lines: a.start === a.end ? 'L' + a.start : 'L' + a.start + '-' + a.end,
    words: MdBoss.suggestedTitle(a.text.split('\n').find((l) => l.trim()) || ''),
    text: a.text,
  })

  // The AI column: one conversation about the open document. The chat (models/aiChat.ts)
  // owns everything said and everything sent; this draws it and hands on what is typed.
  // Return sends, Shift-Return is a new line, Escape stops a reply that is still arriving.
  // The transcript follows new text while you are at its end and stays put once you have
  // scrolled up to read. The pane shares the window's width with the document, so the
  // thread keeps a reading measure of its own rather than running the whole way across.
  class {
    init() {
      // Who answers - the name on every reply card.
      this.state.assistant = 'Claude'
      this.state.ready = false
      this.state.missing = false
      this.state.messages = []
      // The reply as it arrives; null between turns.
      this.state.streaming = null
      this.state.attachments = []
      this.local.chat = null
      this.local.offChat = null
      this.local.stick = true
    }

    onMount() {
      this.local.unsubscribe = [
        MdBoss.manager.onChange(() => this.follow()),
        MdBoss.manager.settings.onChange(() => this.checkClaude()),
      ]
      this.follow()
      this.checkClaude()
    }

    onDestroy() {
      for (const off of this.local.unsubscribe || []) off()
      if (this.local.offChat) this.local.offChat()
    }

    afterRender() {
      const list = this.find('.transcript')
      if (list && this.local.stick) list.scrollTop = list.scrollHeight
    }

    /** The manager swaps the chat when another document opens. */
    follow() {
      const chat = MdBoss.manager.chat
      if (chat !== this.local.chat) {
        if (this.local.offChat) this.local.offChat()
        this.local.chat = chat
        this.local.offChat = chat ? chat.onChange(() => this.pull()) : null
        this.local.stick = true
      }
      this.pull()
    }

    async checkClaude() {
      try {
        this.state.missing = !(await MdBoss.manager.claudeStatus()).path
      } catch {
        // No server to ask: a turn will say what is wrong when there is one.
        this.state.missing = false
      }
    }

    pull() {
      const chat = this.local.chat
      this.state.ready = !!chat
      if (!chat) {
        this.state.messages = []
        this.state.attachments = []
        this.state.streaming = null
        return
      }
      this.state.messages = chat.session.messages.map((m) => ({
        role: m.role,
        text: m.text,
        chips: (m.attachments || []).map(chip),
      }))
      this.state.streaming = chat.state === 'streaming' ? chat.streaming : null
      this.state.attachments = chat.attachments.map(chip)
    }

    /** A link in a reply never navigates the app window: the web goes to the browser, the
     *  rest is followed the way a link in the preview is, against the document's folder. */
    clicked(event) {
      const link = event.target.closest('a')
      if (!link) return
      event.preventDefault()
      const href = link.getAttribute('href') || ''
      if (/^(https?:|mailto:)/i.test(href)) {
        void MdBoss.native().shell.openURL(href)
        return
      }
      const doc = MdBoss.manager.document
      if (doc) void MdBoss.manager.followLink(new URL(href, MdBoss.documentBaseURL(doc.path)).href)
    }

    scrolled(event) {
      const list = event.currentTarget
      this.local.stick = list.scrollHeight - list.scrollTop - list.clientHeight < 40
    }

    keyDown(event) {
      if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
        event.preventDefault()
        this.send()
      } else if (event.key === 'Escape' && this.state.streaming !== null) {
        event.preventDefault()
        this.stop()
      }
    }

    /** The field grows with what is typed, up to a third of the column. */
    grow(field) {
      field.style.height = 'auto'
      field.style.height = Math.min(field.scrollHeight, 220) + 'px'
    }

    send() {
      const field = this.find('.field')
      if (!field || !field.value.trim() || this.state.streaming !== null) return
      const text = field.value
      field.value = ''
      this.grow(field)
      this.local.stick = true
      void MdBoss.manager.sendToChat(text)
    }

    stop() {
      if (this.local.chat) this.local.chat.stop()
    }

    detach(index) {
      if (this.local.chat) this.local.chat.detach(Number(index))
    }
  }
</script>

<style>
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: var(--sidebar-bg);

  .transcript {
    flex: 1;
    min-height: 0;
    overflow: auto;
    padding: 14px 16px;
  }

  /* The reading measure: a wide pane centres the thread instead of stretching every line. */
  .thread,
  .composer .inner {
    width: 100%;
    max-width: 52em;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .thread {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hint {
    margin: auto 0;
  }

  .message {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .message .text {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.45;
  }

  /* What you said: tinted, on the right, the way a chat reads. */
  .message.user {
    align-self: flex-end;
    max-width: 85%;
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--selection);
  }

  /* What came back: the document's own paper, named, full width of the measure. */
  .message.assistant {
    padding: 10px 14px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
  }

  .message .who {
    color: var(--accent);
  }

  .message.error .text {
    padding-left: 8px;
    border-left: 3px solid var(--alert-caution);
    color: var(--alert-caution);
  }

  .message .thinking {
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 5px;
    max-width: 100%;
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--muted);
    white-space: nowrap;
  }

  .chip .lines {
    color: var(--accent);
  }

  .chip .words {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chip button {
    padding: 0 0 0 2px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
  }

  .chip button:hover {
    color: var(--text);
  }

  .composer {
    flex: none;
    padding: 10px 16px 14px;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .composer .inner {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field {
    box-sizing: border-box;
    width: 100%;
    min-height: calc(3 * 1.45em + 12px);
    padding: 6px 8px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font-family: inherit;
    line-height: 1.45;
    resize: none;
    outline: none;
  }

  .field:focus {
    border-color: var(--accent);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .actions .keys {
    flex: 1;
    color: var(--muted);
  }

  .actions button {
    height: calc(var(--font-buttons) + 12px);
    padding: 0 12px;
    border-radius: 5px;
  }
</style>

{#if state.missing}
  <div class="empty-state text-default">Claude Code was not found. Install it from claude.com/claude-code and log in, or set <span class="text-mono">claudePath</span> in settings.json.</div>
{:else if state.ready}
  <div class="transcript" onscroll="fez.scrolled(event)" onclick="fez.clicked(event)">
    <div class="thread">
      {#each state.messages as message}
        <div class={'message ' + message.role}>
          {#if message.role === 'assistant'}
            <span class="who text-title">{state.assistant}</span>
          {/if}
          {#if message.chips.length}
            <div class="chips">
              {#each message.chips as c}
                <span class="chip text-small" title={c.text}><span class="lines text-mono">{c.lines}</span><span class="words">{c.words}</span></span>
              {/each}
            </div>
          {/if}
          {#if message.role === 'assistant'}
            <markdown-text class="text-default" :text="message.text"></markdown-text>
          {:else}
            <div class="text text-default">{message.text}</div>
          {/if}
        </div>
      {:else}
        {#if state.streaming === null}
          <div class="hint empty-state text-default">Talk the document through. Click a block in the preview to point at it.</div>
        {/if}
      {/each}
      {#if state.streaming !== null}
        <div class="message assistant streaming">
          <span class="who text-title">{state.assistant}</span>
          {#if state.streaming}
            <markdown-text class="text-default" :text="state.streaming"></markdown-text>
          {:else}
            <div class="thinking text-default">Thinking…</div>
          {/if}
        </div>
      {/if}
    </div>
  </div>
  <div class="composer">
    <div class="inner">
      {#if state.attachments.length}
        <div class="chips">
          {#each state.attachments as c, index}
            <span class="chip text-small" title={c.text}><span class="lines text-mono">{c.lines}</span><span class="words">{c.words}</span><button class="pointer" title="Remove" onclick="fez.detach({index})">×</button></span>
          {/each}
        </div>
      {/if}
      <textarea class="field text-default" placeholder="Ask, or say what should change…" rows="3" spellcheck="true" onkeydown="fez.keyDown(event)" oninput="fez.grow(this)"></textarea>
      <div class="actions">
        <span class="keys text-small">Return to send, ⇧Return for a new line</span>
        {#if state.streaming !== null}
          <button class="button-outline text-buttons pointer" title="Stop (Esc)" onclick="fez.stop()">Stop</button>
        {:else}
          <button class="button-link text-buttons pointer" onclick="fez.send()">Send</button>
        {/if}
      </div>
    </div>
  </div>
{/if}
