<script>
  // Copy DOC: the open document as rich text, for pasting into a word processor. It sits in
  // the rendered panel's label strip beside copy path. The preview pane owns the render and
  // the manager owns the clipboard write; this is only the button, and it is mounted only
  // for a markdown document, so there is nothing to hide.
  class {
    copy() {
      MdBoss.manager.copyDocument()
    }
  }
</script>

<style>
  display: block;

  /* The same light face as the controls beside it - back-button carries the note on why it
     is bg rather than surface. Sized in border-box so the border does not push it past the
     rail. */
  button {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    height: calc(var(--font-buttons) + 8px);
    padding: 0 7px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--muted);
    font-family: inherit;
    white-space: nowrap;
  }

  button:hover {
    border-color: var(--border-strong);
    background: var(--selection);
    color: var(--text);
  }
</style>

<button class="text-buttons pointer" title="Copy this document as clean text, ready for Google Docs" onclick="fez.copy()">copy doc</button>
