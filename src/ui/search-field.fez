<script>
  // The search field, above the folder box and always on screen. What is typed into it is
  // what decides whether the sidebar shows the tree or a result list; Cmd-Shift-F and Cmd-P
  // only choose which search that is and put the caret here.
  //
  // The input is never bound to state - a re-render would reset the caret - so the field
  // follows the model by hand: the value is pushed only when the model's query differs
  // (a pick that cleared it), and a focus request is a counter the field watches.
  class {
    init() {
      this.state.mode = 'text'
      this.state.placeholder = ''
      this.state.query = ''
      this.state.running = false
      this.state.count = 0
      this.state.truncated = false
    }

    onMount() {
      this.local.focusRequest = MdBoss.manager.search.focusRequest
      this.local.unsubscribe = MdBoss.manager.search.onChange(() => this.pull())
      this.pull()
    }

    onDestroy() {
      if (this.local.unsubscribe) this.local.unsubscribe()
    }

    pull() {
      const search = MdBoss.manager.search
      this.state.mode = search.mode
      this.state.placeholder = MdBoss.SEARCH_PLACEHOLDER[search.mode]
      this.state.query = search.query
      this.state.running = search.isRunning
      this.state.count = search.rowCount
      this.state.truncated = search.truncated
      if (this.input.value !== search.query) this.input.value = search.query
      if (search.focusRequest !== this.local.focusRequest) {
        this.local.focusRequest = search.focusRequest
        this.input.focus()
      }
    }

    typed() {
      MdBoss.manager.search.setQuery(this.input.value)
    }

    /** Bare keys drive the list below; everything else belongs to the field. */
    keyDown(event) {
      if (event.metaKey || event.ctrlKey || event.altKey) return
      const search = MdBoss.manager.search
      switch (event.key) {
        case 'ArrowDown': search.moveCursor(1); break
        case 'ArrowUp':   search.moveCursor(-1); break
        case 'Enter':     MdBoss.manager.openSearchCursor(); break
        case 'Escape':    this.escape(); break
        default:          return
      }
      event.preventDefault()
      event.stopPropagation()
    }

    /** Escape empties the field and gives the keyboard back to the tree. With nothing typed
     *  there is nothing to clear, so it is just a way out of the field. */
    escape() {
      MdBoss.manager.search.clear()
      const tree = document.querySelector('.fez-side-bar')
      if (tree) tree.focus()
      else this.input.blur()
    }
  }
</script>

<style>
  display: block;

  .field {
    display: flex;
    align-items: center;
    gap: 6px;
    height: calc(var(--font-buttons) + 14px);
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    /* bg, not surface, for the same reason as the folder box below: in the paper palette
       surface and sidebar-bg are one hex. */
    background: var(--bg);
    color: var(--text);
  }

  .field:hover,
  .field:focus-within {
    border-color: var(--border-strong);
  }

  .glyph {
    flex: none;
    display: flex;
    width: 14px;
    justify-content: center;
    color: var(--muted);
  }

  .glyph svg {
    width: 12px;
    height: 12px;
  }

  /* Go to File shows the tree's file mark in the accent - the mode has to be readable once
     the placeholder is typed over. */
  .glyph.files {
    color: var(--accent);
    font-size: 0.85em;
  }

  input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font-family: inherit;
    outline: none;
  }

  input::placeholder {
    color: var(--muted);
  }

  .count {
    flex: none;
    color: var(--muted);
  }

  .spinner {
    flex: none;
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--border-strong);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<div class="field">
  <span class={'glyph' + (state.mode === 'files' ? ' files' : '')} title={state.placeholder}>
    {#if state.mode === 'files'}
      ▤
    {:else}
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="6.5" cy="6.5" r="4.5"></circle><path d="M10 10l4 4"></path></svg>
    {/if}
  </span>
  <input class="text-buttons" type="text" fez:this="input" placeholder={state.placeholder} spellcheck="false" autocomplete="off" oninput="fez.typed()" onkeydown="fez.keyDown(event)">
  {#if state.running}
    <span class="spinner"></span>
  {:else if state.query}
    <span class="count text-small text-mono">{state.count}{state.truncated ? '+' : ''}</span>
  {/if}
</div>
