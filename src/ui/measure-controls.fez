<script>
  // Narrow and widen the preview's reading measure. In em, so the column keeps tracking
  // the text size instead of fighting it. In the rendered panel's own label strip rather
  // than in a bar spanning the window: this only affects the rendered column. One step is
  // 2em, about 5% of the default measure (Manager.measureStep).
  class {
    narrower() {
      MdBoss.manager.changeMeasure(-MdBoss.manager.constructor.measureStep)
    }

    wider() {
      MdBoss.manager.changeMeasure(MdBoss.manager.constructor.measureStep)
    }
  }
</script>

<style>
  display: flex;
  align-items: center;
  gap: 2px;

  /* Tracks the button font, so nothing clips once it is raised. Borderless for the same
     reason as the Back button beside it: the strip is the surface. */
  button {
    width: calc(var(--font-buttons) + 8px);
    height: calc(var(--font-buttons) + 6px);
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font-family: inherit;
    font-weight: 600;
  }

  button:hover {
    background: var(--selection);
    color: var(--text);
  }
</style>

<button class="text-buttons pointer" title="Narrower text column (⌘←)" onclick="fez.narrower()">‹</button>
<button class="text-buttons pointer" title="Wider text column (⌘→)" onclick="fez.wider()">›</button>
