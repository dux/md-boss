<script>
  // The rendered side for a delimited file - preview-pane's counterpart: same banner, same
  // Back button, same 250 ms debounce, a different renderer underneath. The table lives in
  // its own iframe (srcdoc) with the csv page; the first render loads the page, later ones
  // call csvRender on the iframe's window so the scroll position - sideways included -
  // survives. Parsing is csvTable.ts, here in the app, and the page only draws.
  const TYPING_DELAY = 250

  class {
    init() {
      this.local.loaded = false
      this.local.pending = null
      this.local.path = null
      this.local.reloadToken = -1
      this.local.typing = null
      // Where to land once the next render is in: the remembered place of a file that just
      // arrived. Pixels, not a line - a table has no anchors and scrolls sideways as well.
      this.local.restoreTo = null
    }

    onMount() {
      this.local.onMessage = (event) => {
        if (event.source !== this.frame.contentWindow) return
        const msg = event.data || {}
        if (msg.kind === 'error') MdBoss.manager.showError('Table: ' + msg.message)
        if (msg.kind === 'ready') {
          this.local.loaded = true
          if (this.local.pending !== null) this.render(this.local.pending)
          this.restore()
        }
        // The page suppresses its own echo after csvScrollTo, so what arrives here is the
        // reader scrolling. Not before ready: a page on its way out would file its own
        // position under the document that is replacing it.
        if (msg.kind === 'scroll' && this.local.loaded && this.local.path) {
          MdBoss.manager.scrollMemory.recordTable(this.local.path, { x: msg.x, y: msg.y })
        }
        if (msg.kind === 'context') this.contextMenu(msg)
      }
      window.addEventListener('message', this.local.onMessage)
      this.local.unsubscribe = [
        MdBoss.manager.onChange(() => this.pull()),
        // Told which theme to use, never left to prefers-color-scheme: the page swaps its
        // <style id=theme> in place, so the scroll position and the table survive.
        MdBoss.manager.settings.onChange((data) => {
          if (data.themeID !== this.local.themeID) {
            this.local.themeID = data.themeID
            if (this.local.loaded) this.frame.contentWindow.csvSetTheme(MdBoss.rootCSS(MdBoss.themeNamed(data.themeID)))
          }
          // The preview's size: this is the rendered pane whichever renderer draws it, so
          // it answers to the same setting and to the same Cmd-+/- zoom.
          if (data.previewFontSize !== this.local.fontSize) {
            this.local.fontSize = data.previewFontSize
            if (this.local.loaded) this.frame.contentWindow.csvSetFontSize(data.previewFontSize)
          }
        }),
      ]
      const data = MdBoss.manager.settings.data
      this.local.themeID = data.themeID
      this.local.fontSize = data.previewFontSize
      this.pull()
    }

    onDestroy() {
      window.removeEventListener('message', this.local.onMessage)
      for (const off of this.local.unsubscribe || []) off()
      if (this.local.typing) clearTimeout(this.local.typing)
    }

    /** A table hangs no notes - it has no source lines to anchor them to - so the menu is
     *  the file's own: copy its path, show it in the file manager. */
    contextMenu(msg) {
      const manager = MdBoss.manager
      const doc = manager.document
      if (!doc) return
      const box = this.frame.getBoundingClientRect()
      MdBoss.menus.open(box.left + (msg.x || 0), box.top + (msg.y || 0), [
        { label: 'Copy Path', action: () => manager.copyText(doc.path, 'Path copied') },
        { label: MdBoss.revealLabel, action: () => manager.showInFileManager(doc.path) },
      ])
    }

    /** Only a delimited file is this pane's business; a markdown document on screen leaves
     *  the table as it was, the way the hidden preview keeps its page. */
    pull() {
      const doc = MdBoss.manager.document
      if (!doc || MdBoss.documentKind(doc.path) !== 'csv') return
      const fresh = doc.path !== this.local.path || doc.reloadToken !== this.local.reloadToken
      if (fresh) {
        if (this.local.typing) clearTimeout(this.local.typing)
        this.local.typing = null
        if (doc.path !== this.local.path) {
          // A page reused for another file would otherwise keep the previous one's offset.
          this.local.restoreTo = MdBoss.manager.scrollMemory.place(doc.path).table ?? { x: 0, y: 0 }
        }
        this.local.path = doc.path
        this.local.reloadToken = doc.reloadToken
        this.render(doc.text)
        return
      }
      if (this.local.typing) clearTimeout(this.local.typing)
      this.local.typing = setTimeout(() => {
        this.local.typing = null
        const current = MdBoss.manager.document
        if (current && current.path === this.local.path) this.render(current.text)
      }, TYPING_DELAY)
    }

    /** The place a file that just arrived was left at. Clamped by the page, which is the
     *  only side that knows how far the table reaches. */
    restore() {
      if (!this.local.loaded || this.local.restoreTo === null) return
      this.frame.contentWindow.csvScrollTo(this.local.restoreTo.x, this.local.restoreTo.y)
      this.local.restoreTo = null
    }

    render(text) {
      const table = MdBoss.parseCSV(text)
      if (this.local.loaded) {
        this.local.pending = null
        this.frame.contentWindow.csvRender(table)
        this.restore()
        return
      }
      if (this.local.pending !== null) {
        // page still loading - the latest text wins when it says ready
        this.local.pending = text
        return
      }
      this.local.pending = text
      this.frame.srcdoc = MdBoss.buildCSVPage({
        table,
        themeCSS: MdBoss.rootCSS(MdBoss.manager.theme),
        fontSize: MdBoss.manager.settings.data.previewFontSize,
      })
    }
  }
</script>

<style>
  display: flex;
  flex-direction: column;
  height: 100%;

  /* Outside the page's scroll, so the Back button stays in its corner while the table
     moves under it - and below the banner, so it is pushed down rather than covered. */
  .page {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--bg);
  }

  /* This is the rendered pane while a CSV is open, so it carries the same corner control -
     otherwise following a link into one is a dead end. */
  .back {
    position: absolute;
    top: 5px;
    left: 12px;
  }
</style>

<change-banner></change-banner>
<div class="page">
  <iframe fez:this="frame" title="table" sandbox="allow-scripts allow-same-origin"></iframe>
  <div class="back"><back-button></back-button></div>
</div>
