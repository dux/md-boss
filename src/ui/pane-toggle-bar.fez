<script>
  // The segmented control at the top of the sidebar. Each segment toggles one pane in or
  // out; the panes then sit side by side in PANES order. The note count lands with P6.
  class {
    init() {
      this.state.segments = []
    }

    onMount() {
      this.local.unsubscribe = [
        MdBoss.manager.settings.onChange(() => this.pull()),
        MdBoss.manager.notes.onChange(() => this.pull()),
        MdBoss.manager.onChange(() => this.pull()),
      ]
      this.pull()
    }

    onDestroy() {
      for (const off of this.local.unsubscribe || []) off()
    }

    pull() {
      const manager = MdBoss.manager
      const visible = MdBoss.visiblePanes(manager.settings.data)
      // The open file's count, matching what the pane leads with rather than a global
      // total that says nothing about what is on screen. Nil when there is nothing to count.
      const notes = manager.notes.noteCount(manager.document ? manager.document.path : null)
      this.state.segments = MdBoss.PANES.map((pane, index) => ({
        pane,
        label: MdBoss.paneShortTitle(pane),
        title: MdBoss.PANE_TITLE[pane],
        count: pane === 'notes' && notes > 0 ? notes : null,
        isOn: visible.includes(pane),
        // A rule butting against the accent fill reads as a seam in it, so the divider is
        // drawn only between two segments that are both off. It keeps its width either
        // way, so toggling a pane does not shift the others by a point.
        seam: index > 0 && !visible.includes(pane) && !visible.includes(MdBoss.PANES[index - 1]),
      }))
    }

    toggle(pane) {
      MdBoss.manager.togglePane(pane)
    }
  }
</script>

<style>
  display: flex;
  height: calc(var(--font-buttons) + 14px);
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  /* bg rather than surface, for the same reason as the folder box below it: in the paper
     palette surface and sidebar-bg are one hex, so a surface control would be invisible. */
  background: var(--bg);

  .segment {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    border: 0;
    border-left: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    font-family: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
  }

  .segment.seam {
    border-left-color: var(--border);
  }

  .segment.on {
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }

  .segment .count {
    margin-left: 3px;
    opacity: 0.75;
  }
</style>

{#each state.segments as segment}
  <button
    class={'segment text-buttons pointer' + (segment.isOn ? ' on' : '') + (segment.seam ? ' seam' : '')}
    title={(segment.isOn ? 'Hide ' : 'Show ') + segment.title}
    onclick="fez.toggle('{segment.pane}')"
  >{segment.label}{#if segment.count} <span class="count text-small text-mono">{segment.count}</span>{/if}</button>
{/each}
