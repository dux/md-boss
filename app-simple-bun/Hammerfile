# Hammerfile - build / run helpers for the simple-bun build of md-boss.
# Run with: cd app-simple-bun && hammer <command>   (https://github.com/dux/hammer)

require 'json'

APP_NAME    ||= 'MdBoss'
BINARY_NAME ||= 'md-boss'
BUNDLE_DIR  ||= "#{APP_NAME}.app"
INSTALL_DIR ||= '/Applications'
VERSION     ||= JSON.parse(File.read('package.json'))['version']
DEV_URL     ||= 'http://localhost:1430'
MIN_BUN     ||= '1.2.0'

# What the payload and the bundle carry besides the shell binary. The server runs from
# source - bun runs TypeScript - so there is nothing to compile on that side.
PAYLOAD_DIRS ||= %w[server dist].freeze

task :install do
  desc 'bun install and cargo fetch - both sides of the toolchain'
  proc do
    sh 'bun install'
    sh 'cd shell && cargo fetch'
  end
end

task :lint do
  desc 'tsc --noEmit and cargo clippy'
  proc do
    sh 'bun x tsc --noEmit'
    sh 'cd shell && cargo clippy --quiet -- -D warnings'
  end
end

task :test do
  desc 'bun test and cargo test'
  proc do
    sh 'bun test --pass-with-no-tests'
    sh 'cd shell && cargo test --quiet'
  end
end

task :server do
  desc 'Run the Bun server alone, on a fixed port, for poking at it with a WebSocket client'
  opt :port, type: :integer, default: 4800, desc: 'Port to listen on'
  proc { |opts| sh "bun server/main.ts --port #{opts[:port]} --token dev" }
end

task :dev do
  desc 'vite on 1430 plus the shell (cargo run) pointed at it - the inner loop'
  proc do
    vite = spawn('bun x vite', out: $stdout, err: $stderr)
    begin
      sh "cd shell && MDBOSS_DEV_URL=#{DEV_URL} MDBOSS_APP_DIR=#{Dir.pwd} cargo run --quiet"
    ensure
      Process.kill('TERM', vite) rescue nil
      Process.wait(vite) rescue nil
    end
  end
end

task :build do
  desc 'Lint, test, build the frontend and the shell, assemble the app bundle (macOS) or a plain layout (elsewhere)'
  opt :release, type: :boolean, desc: 'Optimised shell, and the payload tarball next to it'
  proc do |opts|
    hammer :install
    hammer :lint
    hammer :test
    cfg = opts[:release] ? 'release' : 'debug'
    say "building #{APP_NAME} (simple-bun, #{cfg})", :cyan
    sh 'bun run build'
    sh "cd shell && cargo build --quiet #{opts[:release] ? '--release' : ''}"
    bin = "shell/target/#{cfg}/#{BINARY_NAME}"
    if RUBY_PLATFORM.include?('darwin')
      sh "rm -rf #{BUNDLE_DIR}"
      sh "mkdir -p #{BUNDLE_DIR}/Contents/MacOS #{BUNDLE_DIR}/Contents/Resources"
      plist = File.read('shell/Info.plist').gsub('__VERSION__', VERSION)
      File.write("#{BUNDLE_DIR}/Contents/Info.plist", plist)
      sh "cp #{bin} #{BUNDLE_DIR}/Contents/MacOS/#{BINARY_NAME}"
      sh "cp icons/icon.icns #{BUNDLE_DIR}/Contents/Resources/AppIcon.icns" if File.exist?('icons/icon.icns')
      PAYLOAD_DIRS.each { |d| sh "cp -R #{d} #{BUNDLE_DIR}/Contents/Resources/" }
      File.write("#{BUNDLE_DIR}/Contents/Resources/version.txt", "#{VERSION}\n")
      say.green "built ./#{BUNDLE_DIR}"
    else
      out = "out/#{BINARY_NAME}"
      sh "rm -rf out && mkdir -p #{out}"
      sh "cp #{bin} #{out}/"
      PAYLOAD_DIRS.each { |d| sh "cp -R #{d} #{out}/" }
      File.write("#{out}/version.txt", "#{VERSION}\n")
      say.green "built ./#{out}"
    end
    hammer :payload if opts[:release]
  end
end

task :run do
  desc 'Launch the bundle built here (macOS) or the plain layout'
  proc do
    if RUBY_PLATFORM.include?('darwin')
      sh "open #{BUNDLE_DIR}"
    else
      sh "out/#{BINARY_NAME}/#{BINARY_NAME}"
    end
  end
end

task :install_app do
  desc "Copy the bundle into #{INSTALL_DIR} (macOS)"
  proc do
    raise 'macOS only' unless RUBY_PLATFORM.include?('darwin')
    `pkill -x "#{BINARY_NAME}" 2>/dev/null`
    sh "rm -rf #{INSTALL_DIR}/#{BUNDLE_DIR}"
    sh "cp -R #{BUNDLE_DIR} #{INSTALL_DIR}/"
    say.green "installed to #{INSTALL_DIR}/#{BUNDLE_DIR}"
  end
end

task :icon do
  desc 'Regenerate icons/ from ../app/Resources/AppIcon.svg (icns on macOS, png set everywhere)'
  proc do
    svg = '../app/Resources/AppIcon.svg'
    sh 'mkdir -p icons'
    [16, 32, 64, 128, 256, 512, 1024].each do |size|
      sh "rsvg-convert -w #{size} -h #{size} #{svg} -o icons/icon_#{size}.png"
    end
    if RUBY_PLATFORM.include?('darwin')
      iconset = 'icons/AppIcon.iconset'
      sh "rm -rf #{iconset} && mkdir -p #{iconset}"
      [16, 32, 128, 256, 512].each do |size|
        sh "cp icons/icon_#{size}.png #{iconset}/icon_#{size}x#{size}.png"
        sh "cp icons/icon_#{size * 2}.png #{iconset}/icon_#{size}x#{size}@2x.png"
      end
      sh "iconutil -c icns #{iconset} -o icons/icon.icns"
      sh "rm -rf #{iconset}"
    end
    say.green 'icons regenerated'
  end
end

task :payload do
  desc 'Write payload-<version>.tar.gz: server/, dist/, version.txt - what an update replaces'
  proc do
    raise 'dist/ is missing - run `hammer build` first' unless Dir.exist?('dist')
    File.write('version.txt', "#{VERSION}\n")
    name = "payload-#{VERSION}.tar.gz"
    sh "tar czf #{name} #{PAYLOAD_DIRS.join(' ')} version.txt"
    sh "shasum -a 256 #{name} > #{name}.sha256"
    sh 'rm version.txt'
    say.green "wrote ./#{name}"
  end
end

task :link do
  desc 'Put the md-boss command on PATH: bin/md-boss copied to ~/bin'
  proc do
    sh 'mkdir -p ~/bin'
    sh 'install -m 755 bin/md-boss ~/bin/md-boss'
    say.green 'installed ~/bin/md-boss'
  end
end
