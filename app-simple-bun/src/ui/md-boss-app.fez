<script>
  // 190 rather than 160: the top row grows a Back button and three toggle segments (P4),
  // and a segment narrow enough to truncate "Notes" no longer says what it does.
  const MIN_SIDEBAR = 190
  const MAX_SIDEBAR = 520

  // Root layout: sidebar | divider | document, status bar across the bottom - the shape of
  // the Swift ContentView. The sidebar holds the root picker and the tree; Cmd-0 hides it
  // and the divider drags its width, both persisted through settings. The document side
  // shows whichever panes are switched on, left to right: preview, raw (notes with P6).
  // Side by side, preview and raw split the width evenly; the preview's reading column
  // keeps its measure while the half fits it and narrows with the pane when it does not.
  class {
    init() {
      const data = MdBoss.manager.settings.data
      this.state.sidebarWidth = data.sidebarWidth
      this.state.showSidebar = data.showSidebar
      this.state.panes = MdBoss.visiblePanes(data)
      this.state.dragging = false
      this.state.root = null
      this.state.file = null
      // Which renderer the rendered pane shows: the file's own answer (documentKind), not a
      // mode the viewer is in.
      this.state.kind = null
      this.state.dirty = false
    }

    onMount() {
      this.local.unsubscribe = [
        MdBoss.manager.onChange(() => this.pull()),
        MdBoss.manager.settings.onChange((data) => {
          this.state.sidebarWidth = data.sidebarWidth
          this.state.showSidebar = data.showSidebar
          this.state.panes = MdBoss.visiblePanes(data)
          this.toggleClass('no-sidebar', !data.showSidebar)
        }),
      ]
      this.toggleClass('no-sidebar', !this.state.showSidebar)
      this.pull()
    }

    onDestroy() {
      for (const off of this.local.unsubscribe || []) off()
    }

    pull() {
      const manager = MdBoss.manager
      this.state.root = manager.activeRoot
      this.state.file = manager.document ? manager.abbreviateHome(manager.document.path) : null
      this.state.kind = manager.document ? MdBoss.documentKind(manager.document.path) : null
      this.state.dirty = manager.isDirty
    }

    save() {
      MdBoss.manager.saveDocument()
    }

    // MARK: Divider

    // The width the drag started from plus the pointer's travel, so the pane tracks the
    // cursor exactly instead of accumulating rounding drift across move events. Pointer
    // capture keeps the moves coming while the pointer is over the preview iframe.
    dragStart(event) {
      if (event.button !== 0) return
      const divider = event.currentTarget
      const startX = event.clientX
      const startWidth = MdBoss.manager.settings.data.sidebarWidth
      const move = (e) => {
        const width = Math.min(MAX_SIDEBAR, Math.max(MIN_SIDEBAR, startWidth + e.clientX - startX))
        MdBoss.manager.settings.patch({ sidebarWidth: Math.round(width) })
      }
      const end = () => {
        divider.removeEventListener('pointermove', move)
        divider.removeEventListener('pointerup', end)
        divider.removeEventListener('pointercancel', end)
        this.state.dragging = false
        this.toggleClass('dragging', false)
      }
      divider.setPointerCapture(event.pointerId)
      divider.addEventListener('pointermove', move)
      divider.addEventListener('pointerup', end)
      divider.addEventListener('pointercancel', end)
      this.state.dragging = true
      this.toggleClass('dragging', true)
      event.preventDefault()
    }
  }
</script>

<style>
  display: grid;
  height: 100%;
  /* Explicit placement rather than grid-template-areas: the fez CSS minifier collapses
     the whitespace between area names and the value turns invalid. */
  grid-template-columns: auto auto 1fr;
  grid-template-rows: 1fr auto;

  /* Hidden, not unmounted: the tree keeps its scroll and the picker its state while the
     sidebar is away, and Cmd-0 back costs no relisting. The class sits on the wrapper node,
     outside the template, so it is toggled by hand when the setting changes - a render
     whose HTML has not changed is skipped by fez, afterRender included. */
  &.no-sidebar aside,
  &.no-sidebar .divider {
    display: none;
  }

  aside {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--sidebar-bg);
    box-sizing: border-box;

    .top {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 8px;
    }

    .fez-side-bar {
      flex: 1;
      min-height: 0;
    }
  }

  /* A hairline that widens and takes the accent while it is being dragged; the padding
     either side is the grab area. */
  .divider {
    grid-column: 2;
    grid-row: 1;
    width: 5px;
    cursor: col-resize;
    touch-action: none;
    display: flex;
    justify-content: center;
  }

  .divider span {
    display: block;
    width: 1px;
    height: 100%;
    background: var(--border-strong);
  }

  .divider.dragging span {
    width: 2px;
    background: var(--accent);
  }

  main {
    grid-column: 3;
    grid-row: 1;
    min-height: 0;
    min-width: 460px;
    display: flex;
  }

  main .pane {
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
  }

  main .pane.hidden {
    display: none;
  }

  /* Notes are a list, so they get a fixed column (paneFixedWidth). */
  main .pane.notes {
    flex: 0 0 350px;
    border-left: 0;
  }

  main .separator {
    flex: none;
    width: 1px;
    margin: 0 2px;
    background: var(--border);
  }

  .pane-empty {
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--muted);
  }

  .empty {
    font-size: var(--font-default);
  }

  /* The preview iframe would swallow the pointer mid-drag. */
  &.dragging iframe {
    pointer-events: none;
  }

  .empty {
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--muted);
  }

  footer {
    grid-column: 1 / 4;
    grid-row: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    height: calc(var(--font-small) + 13px);
    border-top: 1px solid var(--border);
    padding: 0 12px;
    background: var(--surface);
    color: var(--muted);
    white-space: nowrap;
  }

  footer .path {
    overflow: hidden;
    text-overflow: ellipsis;
    /* Truncated from the head - the tail of a path is the part that tells files apart. */
    direction: rtl;
    text-align: left;
  }

  footer .path bdi {
    direction: ltr;
    unicode-bidi: isolate;
  }

  /* The one control down here, and only when there is something to do with it. It says
     what an "edited" label would say and does something about it. Link blue rather than
     the accent: this is the call to action; the label takes bg to stay readable on every
     palette's blue. */
  footer .save {
    flex: none;
    height: calc(var(--font-small) + 7px);
    padding: 0 9px;
    border: 0;
    border-radius: 4px;
    background: var(--link);
    color: var(--bg);
    font-family: inherit;
    font-weight: 600;
  }
</style>

<aside style="width: {state.sidebarWidth}px">
  <div class="top">
    <pane-toggle-bar></pane-toggle-bar>
    <!-- Always on screen. The field is how you search, so hiding it until a shortcut is
         pressed is hiding the feature. -->
    <search-field></search-field>
    <root-picker></root-picker>
  </div>
  <side-bar></side-bar>
</aside>
<div class={'divider' + (state.dragging ? ' dragging' : '')} role="separator" aria-orientation="vertical" aria-label="Sidebar width" aria-valuenow={state.sidebarWidth} title="Drag to resize the sidebar" onpointerdown="fez.dragStart(event)"><span></span></div>
<main>
  {#unless state.file}
    <div class="empty">Open a folder to begin</div>
  {/unless}
  <!-- Always mounted, hidden rather than removed: the iframe keeps its page and its
       scroll, and the first render after a file opens has somewhere to land. One toggle,
       two renderers - a .csv shows the table pane in the preview's place. -->
  <div class={'pane preview' + (state.file && state.panes.includes('preview') && state.kind === 'markdown' ? '' : ' hidden')}>
    <preview-pane></preview-pane>
  </div>
  <div class={'pane preview table' + (state.file && state.panes.includes('preview') && state.kind === 'csv' ? '' : ' hidden')}>
    <csv-pane></csv-pane>
  </div>
  {#if state.file && state.panes.includes('raw')}
    {#if state.panes.includes('preview')}
      <div class="separator"></div>
    {/if}
    <div class="pane raw">
      <editor-pane></editor-pane>
    </div>
  {/if}
  {#if state.panes.includes('notes')}
    {#if state.file && (state.panes.includes('preview') || state.panes.includes('raw'))}
      <div class="separator"></div>
    {/if}
    <div class="pane notes"><notes-pane></notes-pane></div>
  {/if}
</main>
<settings-panel></settings-panel>
<prompt-panel></prompt-panel>
<context-menu></context-menu>
<toast-overlay></toast-overlay>
<!-- The footer holds only the open file's path: what the app has to say goes to the toast,
     as StatusBarView.swift put it - a markdown reader should not push the text around to
     say something. -->
<footer class="text-small">
  {#if state.dirty}
    <button class="save text-small pointer" title="Save (⌘S)" onclick="fez.save()">Save</button>
  {/if}
  <span class="path"><bdi>{state.file || 'No file open'}</bdi></span>
</footer>
