<script>
  // The sidebar's root-folder select box. Hand-rolled rather than a <select>: system popup
  // chrome cannot be forced to the paper palette, and this box sits directly on the sidebar
  // where any mismatch shows. The dropped-open list covers the tree instead of pushing it
  // down, which is what makes it read as a select box rather than a disclosure group.
  //
  // While the list is open it owns the keyboard - it is a modal choice, not a second list -
  // so keys are taken in the capture phase, before the tree behind it sees them.
  //
  // The box also stands for the root folder itself, which has no row in the tree: it is
  // where a cut or dragged file goes to come back up to the top - right-click "Move Here",
  // or a drop on the box.
  //
  // Alongside it, at the right edge of the row, the re-read button: the tree is watched and
  // polled, so this is for the times you already know something changed and do not want to
  // wait to be told - a network volume, a checkout in another window.
  class {
    init() {
      this.state.active = null
      this.state.activeName = ''
      this.state.recent = []
      this.state.open = false
      this.state.cursor = 0
      this.state.drop = false
      this.state.spinning = false
    }

    onMount() {
      this.local.nativeDragged = null
      const unlisten = MdBoss.native().onFileDrag((drag) => this.nativeDrag(drag))
      this.local.unsubscribe = [
        MdBoss.manager.onChange(() => this.pull()),
        () => unlisten.then((off) => off()),
      ]
      this.on(document, 'click', (event) => {
        if (this.state.open && !this.root.contains(event.target)) this.state.open = false
      })
      this.on(document, 'keydown', (event) => this.keyDown(event), { capture: true })
      this.pull()
    }

    onDestroy() {
      for (const off of this.local.unsubscribe || []) off()
    }

    keyDown(event) {
      if (!this.state.open || event.metaKey || event.ctrlKey || event.altKey) return
      const count = this.state.recent.length
      switch (event.key) {
        case 'Escape':
          this.state.open = false
          break
        case 'ArrowDown':
          this.state.cursor = Math.min(count - 1, this.state.cursor + 1)
          break
        case 'ArrowUp':
          this.state.cursor = Math.max(0, this.state.cursor - 1)
          break
        case 'Enter':
        case ' ': {
          const item = this.state.recent[this.state.cursor]
          if (item) this.pick(item.path)
          this.state.open = false
          break
        }
        default:
          return
      }
      event.preventDefault()
      event.stopPropagation()
    }

    pull() {
      const manager = MdBoss.manager
      const active = manager.activeRoot
      this.state.active = active
      this.state.activeName = active ? active.slice(active.lastIndexOf('/') + 1) : ''
      this.state.recent = manager.folders.recent.map((path) => ({
        path,
        name: path.slice(path.lastIndexOf('/') + 1),
        parent: manager.abbreviateHome(path.slice(0, path.lastIndexOf('/')) || '/'),
        isActive: path === active,
      }))
    }

    boxClicked() {
      if (!this.state.active) MdBoss.manager.addFolders()
      else {
        this.state.cursor = 0
        this.state.open = !this.state.open
      }
    }

    pick(path) {
      MdBoss.manager.selectRoot(path)
      this.state.open = false
    }

    /** The whole tree from disk again. A local root comes back before the glyph has turned
     *  once, so the turn is held for one full revolution - a control that flickers reads as
     *  a control that did nothing. */
    async refresh() {
      if (this.state.spinning) return
      this.state.spinning = true
      const turn = new Promise((done) => setTimeout(done, 550))
      try {
        await MdBoss.manager.tree.refreshAll()
      } finally {
        await turn
        this.state.spinning = false
      }
    }

    // MARK: Moving into the root

    async menu(event) {
      event.preventDefault()
      event.stopPropagation()
      const manager = MdBoss.manager
      const active = manager.activeRoot
      if (!active) return
      const { clientX, clientY } = event
      const items = []
      const cut = manager.cutFile
      if (cut && await manager.canMove(cut, active)) {
        items.push({ label: `Move ${cut.slice(cut.lastIndexOf('/') + 1)} Here`, action: () => manager.moveCut(active) })
        items.push({ separator: true })
      }
      items.push({ label: 'Copy Path', action: () => manager.copyText(active, 'Path copied') })
      items.push({ label: 'Copy Name', action: () => manager.copyText(this.state.activeName, 'Name copied') })
      items.push({ separator: true })
      items.push({ label: MdBoss.revealLabel, action: () => manager.showInFileManager(active) })
      items.push({ separator: true })
      items.push({ label: 'Remove from Sidebar', action: () => manager.removeRoot(active) })
      MdBoss.menus.open(clientX, clientY, items)
    }

    /** The same asking as the tree's folder rows: the move check, cached for one hover, and
     *  the box lights up only once it has said yes. */
    hover(dragged) {
      const manager = MdBoss.manager
      const active = manager.activeRoot
      if (!dragged || !active) return false
      let probe = this.local.dropProbe
      if (!probe || probe.path !== active || probe.dragged !== dragged) {
        probe = { path: active, dragged, ok: false }
        this.local.dropProbe = probe
        manager.canMove(dragged, active).then((ok) => {
          if (this.local.dropProbe === probe) probe.ok = ok
        })
      }
      if (!probe.ok) return false
      this.state.drop = true
      return true
    }

    dropHere(dragged) {
      const probe = this.local.dropProbe
      this.dragLeave()
      if (!probe || !probe.ok) return false
      MdBoss.manager.dropDragged(probe.path, dragged)
      return true
    }

    dragOver(event) {
      if (!this.hover(MdBoss.manager.draggedFile)) return
      event.preventDefault()
      event.dataTransfer.dropEffect = 'move'
    }

    dragLeave() {
      this.local.dropProbe = null
      this.state.drop = false
    }

    drop(event) {
      if (this.dropHere(MdBoss.manager.draggedFile)) event.preventDefault()
    }

    /** The native drag events the Tauri shell delivers instead of HTML5 drops (the sidebar
     *  has the longer note). The box is the target while the pointer is over it. */
    nativeDrag(drag) {
      if (drag.kind === 'enter') this.local.nativeDragged = drag.paths.length ? null : MdBoss.manager.draggedFile
      const dragged = this.local.nativeDragged
      if (!dragged) return
      const over = drag.kind !== 'leave' && MdBoss.isInside(this.find('.box'), drag.x, drag.y)
      if (drag.kind === 'drop') {
        this.local.nativeDragged = null
        if (over) this.dropHere(dragged)
        else this.dragLeave()
      } else if (drag.kind === 'leave') {
        this.local.nativeDragged = null
        this.dragLeave()
      } else if (over) {
        this.hover(dragged)
      } else {
        this.dragLeave()
      }
    }
  }
</script>

<style>
  display: flex;
  align-items: center;
  gap: 6px;
  position: relative;

  .box {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    height: calc(var(--font-buttons) + 14px);
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    /* bg, not surface: in the paper palette surface and sidebar-bg are the same hex, so a
       surface box would be invisible against the sidebar. */
    background: var(--bg);
    color: var(--text);
    font-weight: 500;
    cursor: pointer;
    user-select: none;
  }

  .box:hover,
  .box.open {
    border-color: var(--border-strong);
  }

  /* A dragged file over the box: the border it already has does the work. */
  .box.drop {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 0.5px var(--accent);
  }

  .box.empty {
    color: var(--muted);
  }

  .box .name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .box .glyph {
    color: var(--accent);
    font-size: 0.85em;
  }

  .box.empty .glyph,
  .box .updown {
    color: var(--muted);
  }

  .box .updown {
    font-size: 0.7em;
  }

  /* Icon only, no border until it is under the pointer: it sits beside a bordered box and
     two outlines side by side would read as two equals. */
  .refresh {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--font-buttons) + 14px);
    height: calc(var(--font-buttons) + 14px);
    padding: 0;
    border: 1px solid transparent;
    border-radius: 6px;
    background: none;
    color: var(--muted);
  }

  .refresh:hover {
    border-color: var(--border);
    color: var(--text);
  }

  .refresh svg {
    width: 14px;
    height: 14px;
  }

  .refresh.spinning svg {
    animation: refresh-turn 0.55s linear infinite;
  }

  @keyframes refresh-turn {
    to {
      transform: rotate(360deg);
    }
  }

  .list {
    position: absolute;
    left: 0;
    right: 0;
    top: 30px;
    z-index: 10;
    max-height: 60vh;
    overflow: auto;
    padding: 4px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--bg);
    box-shadow: 0 2px 8px var(--border-strong);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 22px;
    padding: 0 6px;
    border-radius: 5px;
    cursor: default;
    white-space: nowrap;
  }

  .row:hover,
  .row.cursor {
    background: var(--selection);
  }

  .row .check {
    width: 10px;
    flex: none;
    color: var(--accent);
    font-size: 0.8em;
  }

  /* Truncated from the head - the tail of a path is the part that tells two "docs" apart.
     The rtl container does the clipping; the bdi keeps the text itself reading left to right. */
  .row .parent {
    overflow: hidden;
    text-overflow: ellipsis;
    direction: rtl;
    text-align: left;
    color: var(--muted);
  }

  .row .parent bdi {
    direction: ltr;
    unicode-bidi: isolate;
  }

  .row.active .name {
    font-weight: 600;
  }
</style>

<div class={'box text-default pointer' + (state.active ? '' : ' empty') + (state.open ? ' open' : '') + (state.drop ? ' drop' : '')} title={state.active || 'Add a folder (⌘O)'} onclick="fez.boxClicked()" oncontextmenu="fez.menu(event)" ondragover="fez.dragOver(event)" ondragleave="fez.dragLeave()" ondrop="fez.drop(event)">
  <span class="glyph">▰</span>
  <span class="name">{state.active ? state.activeName : 'Add a folder…'}</span>
  <span class="updown">▲▼</span>
</div>
<button class={'refresh pointer' + (state.spinning ? ' spinning' : '')} title="Refresh the folder list" aria-label="Refresh the folder list" onclick="fez.refresh()">{@html MdBoss.refreshIcon}</button>
{#if state.open}
  <div class="list">
    {#each state.recent as item, index}
      <div class={'row text-default' + (item.isActive ? ' active' : '') + (index === state.cursor ? ' cursor' : '')} title={item.path} onclick="fez.pick('{item.path}')">
        <span class="check">{item.isActive ? '✓' : ''}</span>
        <span class="name">{item.name}</span>
        <span class="parent text-small"><bdi>{item.parent}</bdi></span>
      </div>
    {/each}
  </div>
{/if}
